# Local DreamHost / SFTP credentials for `npm run deploy`.
# Copy to `.env.deploy` in the repo root (gitignored) and fill in the password.
# Existing environment variables always win over this file.

DEPLOY_HOST=1ink.us
DEPLOY_PORT=22
DEPLOY_USER=ford442
DEPLOY_PASS=

# Optional: passwordless SFTP if this key is authorized on DreamHost.
# DEPLOY_KEY=~/.ssh/id_ed25519

# FTP_* aliases are also accepted (DEPLOY_* wins if both are set).
# FTP_USER=ford442
# FTP_PASS=

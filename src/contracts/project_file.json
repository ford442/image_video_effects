{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelocity.app/contracts/project_file.v2.schema.json",
  "title": "Pixelocity project file",
  "description": "A user-owned, local project file for the recoverable parts of a Pixelocity VJ session. v2 (#1512) adds the per-slot compositor fields b/o/m/k and render.hdr; a v1 file is migrated in one step (src/services/project/migrate.ts migrateV1ToV2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "app", "createdAt", "chain", "activeSlot", "source", "render"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "pixelocity" },
        "version": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "chain": { "$ref": "#/$defs/sharedChain" },
    "activeSlot": { "type": "integer", "minimum": 0, "maximum": 5 },
    "source": { "$ref": "#/$defs/source" },
    "render": { "$ref": "#/$defs/render" },
    "audio": { "$ref": "#/$defs/audio" },
    "timeline": { "$ref": "#/$defs/vjSetExport" }
  },
  "$defs": {
    "slotParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "zoomParam1": { "type": "number" },
        "zoomParam2": { "type": "number" },
        "zoomParam3": { "type": "number" },
        "zoomParam4": { "type": "number" },
        "lightStrength": { "type": "number" },
        "ambient": { "type": "number" },
        "normalStrength": { "type": "number" },
        "fogFalloff": { "type": "number" },
        "depthThreshold": { "type": "number" }
      }
    },
    "sharedChainSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shaderId"],
      "properties": {
        "shaderId": { "type": ["string", "null"], "maxLength": 128 },
        "params": { "$ref": "#/$defs/slotParams" },
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["chained", "parallel"] },
        "b": {
          "description": "Compositor output (#1512): 'mask' (a matte other slots can use) or a blend mode; absent = replace.",
          "enum": ["mask", "normal", "add", "screen", "multiply", "overlay", "soft-light", "difference", "luma-key", "depth-key"]
        },
        "o": { "description": "Layer opacity; absent = 1.", "type": "number", "minimum": 0, "maximum": 1 },
        "m": {
          "description": "Mask ref [!]<src>[~<feather>]: src l (luma), d (depth), s0..s5 (a slot's matte); '!' inverts.",
          "type": "string",
          "pattern": "^(!)?(l|d|s[0-5])(~(\\d*\\.?\\d+))?$"
        },
        "k": { "description": "Key threshold for luma-key / depth-key; absent = the mode default.", "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "sharedChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "slots"],
      "properties": {
        "v": { "const": 1 },
        "slots": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/sharedChainSlot" }
        }
      }
    },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\s*(?:data|blob):)(?!.*(?:MediaStream|permission)).+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["image", "video", "webcam", "generative", "stream", "none"] },
        "ref": { "$ref": "#/$defs/safeRef" },
        "generativeShaderId": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["image", "video", "stream"] } } },
          "then": { "required": ["ref"] }
        },
        {
          "if": { "properties": { "kind": { "const": "generative" } } },
          "then": { "required": ["generativeShaderId"] }
        }
      ]
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "renderScale": { "type": "number", "minimum": 0.25, "maximum": 1 },
        "quality": { "enum": ["battery", "balanced", "ultra", "auto"] },
        "hdr": {
          "description": "Final tonemap of the HDR (rgba16float, extended tone mapping) canvas; ignored on SDR output.",
          "type": "object",
          "additionalProperties": false,
          "required": ["paperWhiteNits", "peakNits"],
          "properties": {
            "paperWhiteNits": { "type": "number", "minimum": 80, "maximum": 10000 },
            "peakNits": { "type": "number", "minimum": 80, "maximum": 10000 }
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "id"],
      "properties": {
        "source": { "enum": ["midi-cc", "midi-note", "key"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "slot", "param"],
          "properties": {
            "type": { "const": "setSlotParam" },
            "slot": { "type": "integer", "minimum": 0, "maximum": 5 },
            "param": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "slot"],
          "properties": {
            "type": { "const": "randomizeSlot" },
            "slot": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "enum": ["randomizeAll", "triggerTransition", "toggleAutoTransition"] }
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "action"],
      "properties": {
        "trigger": { "$ref": "#/$defs/trigger" },
        "action": { "$ref": "#/$defs/action" }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mappings": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/binding" }
        }
      }
    },
    "timelineEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "slot", "kind", "value"],
          "properties": {
            "t": { "type": "number", "minimum": 0 },
            "slot": { "type": "integer", "minimum": 0, "maximum": 5 },
            "kind": { "const": "shader" },
            "value": { "type": "string", "minLength": 1, "maxLength": 128 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["t", "slot", "kind", "key", "value"],
          "properties": {
            "t": { "type": "number", "minimum": 0 },
            "slot": { "type": "integer", "minimum": 0, "maximum": 5 },
            "kind": { "const": "param" },
            "key": { "enum": ["zoomParam1", "zoomParam2", "zoomParam3", "zoomParam4"] },
            "value": { "type": "number" }
          }
        }
      ]
    },
    "vjTimeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hz", "durationMs", "events"],
      "properties": {
        "hz": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
        "durationMs": { "type": "number", "minimum": 0 },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200000,
          "items": { "$ref": "#/$defs/timelineEvent" }
        }
      }
    },
    "vjSetExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exportVersion", "name", "savedAt", "chain", "chainString"],
      "properties": {
        "exportVersion": { "const": 1 },
        "name": { "type": "string", "minLength": 1 },
        "vibePrompt": { "type": "string" },
        "savedAt": { "type": "number" },
        "chain": { "$ref": "#/$defs/sharedChain" },
        "chainString": { "type": "string", "minLength": 1 },
        "bindings": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/binding" }
        },
        "timeline": { "$ref": "#/$defs/vjTimeline" }
      }
    }
  }
}

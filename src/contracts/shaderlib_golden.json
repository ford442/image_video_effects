    {
      "id": "math.safePow.negative",
      "modules": [
        "math"
      ],
      "expr": "safePow(-8.0, 1.0 / 3.0)",
      "type": "f32",
      "expected": [
        -2
      ],
      "tol": 0.00001,
      "analytic": true
    },

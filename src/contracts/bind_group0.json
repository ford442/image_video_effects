{
  "version": 1,
  "description": "The compute @group(0) layout (bindings 0–13) shared by every catalog shader. Single source for the TS layout (src/renderer/webgpu/pipeline.ts createComputeBindGroupLayout imports this JSON) and the C++ one (wasm_renderer/bind_group0.h, generated by scripts/gen-bind-group0-header.js). `npm run verify:device-policy` fails when the header is stale or either side stops reading the contract. Human-readable table: docs/BINDING_CONTRACT.md.",
  "group": 0,
  "cpp": { "header": "wasm_renderer/bind_group0.h" },
  "sampleTypes": {
    "color-format": "rgba16float is always filterable → 'float'; rgba32float is 'float' only with the float32-filterable device feature, else 'unfilterable-float'. Shaders pair readTexture with the filtering u_sampler, so the format policy prefers rgba16float when the feature is missing.",
    "unfilterable-float": "r32float without float32-filterable. Always unfilterable so the layout is identical on every device; sample depth with non_filtering_sampler (binding 5) or textureLoad, never u_sampler."
  },
  "kinds": {
    "filtering-sampler":        { "sampler": "filtering" },
    "non-filtering-sampler":    { "sampler": "non-filtering" },
    "comparison-sampler":       { "sampler": "comparison" },
    "sampled-rgba":             { "texture": { "sampleType": "color-format", "viewDimension": "2d" } },
    "sampled-rgba-array":       { "texture": { "sampleType": "color-format", "viewDimension": "2d-array" } },
    "sampled-r32":              { "texture": { "sampleType": "unfilterable-float", "viewDimension": "2d" } },
    "storage-rgba":             { "storageTexture": { "access": "write-only", "format": "color-format" } },
    "storage-r32":              { "storageTexture": { "access": "write-only", "format": "r32float" } },
    "uniform-buffer":           { "buffer": "uniform" },
    "storage-buffer":           { "buffer": "storage" },
    "read-only-storage-buffer": { "buffer": "read-only-storage" }
  },
  "bindings": [
    { "binding": 0,  "name": "u_sampler",             "kind": "filtering-sampler",        "resource": "filteringSampler" },
    { "binding": 1,  "name": "readTexture",           "kind": "sampled-rgba",             "resource": "input" },
    { "binding": 2,  "name": "writeTexture",          "kind": "storage-rgba",             "resource": "output" },
    { "binding": 3,  "name": "u",                     "kind": "uniform-buffer",           "resource": "uniforms" },
    { "binding": 4,  "name": "readDepthTexture",      "kind": "sampled-r32",              "resource": "depthRead" },
    { "binding": 5,  "name": "non_filtering_sampler", "kind": "non-filtering-sampler",    "resource": "nonFilteringSampler" },
    { "binding": 6,  "name": "writeDepthTexture",     "kind": "storage-r32",              "resource": "depthWrite" },
    { "binding": 7,  "name": "dataTextureA",          "kind": "storage-rgba",             "resource": "dataA" },
    { "binding": 8,  "name": "dataTextureB",          "kind": "storage-rgba",             "resource": "dataB" },
    { "binding": 9,  "name": "dataTextureC",          "kind": "sampled-rgba",             "resource": "dataC" },
    { "binding": 10, "name": "extraBuffer",           "kind": "storage-buffer",           "resource": "extra" },
    { "binding": 11, "name": "comparison_sampler",    "kind": "comparison-sampler",       "resource": "comparisonSampler" },
    { "binding": 12, "name": "plasmaBuffer",          "kind": "read-only-storage-buffer", "resource": "plasma" },
    { "binding": 13, "name": "historyTexture",        "kind": "sampled-rgba-array",       "resource": "history" }
  ]
}

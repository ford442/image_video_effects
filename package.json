{
  "name": "webgpu-react-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@mlc-ai/web-llm": "^0.2.80",
    "@xyflow/react": "^12.12.0",
    "hls.js": "^1.6.15",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "webm-muxer": "^5.1.4"
  },
  "scripts": {
    "prestart": "npm run gen",
    "start": "vite",
    "prebuild": "npm run wasm:build && npm run gen",
    "build": "vite build",
    "build:manifest": "tsx --tsconfig scripts/tsconfig.scripts.json scripts/build-unified-manifest.ts",
    "build:search-index": "node scripts/build-shader-search-index.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.scripts.json",
    "lint": "eslint src --max-warnings 125",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "wasm:build": "bash wasm_renderer/build.sh",
    "wasm:build:debug": "WASM_PROFILE=debug bash wasm_renderer/build.sh",
    "wasm:build:asan": "WASM_PROFILE=debug WASM_ASAN=1 bash wasm_renderer/build.sh",
    "wasm:compdb": "node scripts/format-wasm-compile-flags.js compdb",
    "wasm:compile-commands": "node scripts/format-wasm-compile-flags.js compdb",
    "gen:canvas-configure": "node scripts/gen-canvas-configure-header.js",
    "gen:webgpu-limits": "node scripts/gen-webgpu-limits-header.js",
    "wasm:validate": "node scripts/validate_wasm_artifacts.js",
    "wasm:clean": "rm -rf wasm_renderer/build public/wasm",
    "test:wasm:unit": "vitest run WASM",
    "test:engine2": "playwright test --project=swiftshader",
    "test:engine2:isolated": "PX_ISOLATED=1 playwright test --project=swiftshader",
    "test:engine2:smoke": "playwright test --project=swiftshader-smoke && PX_RENDER_THREAD=main playwright test --project=swiftshader-smoke",
    "test:wasm:e2e": "playwright test tests/wasm-renderer.smoke.spec.ts tests/layerChain.smoke.spec.ts --project=chromium",
    "test:wasm:parity": "playwright test tests/renderer-parity.spec.ts --project=chromium",
    "test:wasm:bench": "playwright test tests/wasm-benchmark.spec.ts --project=chromium",
    "test:wasm:pixeldiff": "playwright test tests/wasm-pixel-diff.spec.ts --project=chromium",
    "test:wasm:gpu": "playwright test tests/renderer-parity.spec.ts tests/wasm-benchmark.spec.ts tests/wasm-pixel-diff.spec.ts --project=chromium",
    "test:wasm": "npm run test:wasm:unit && npm run test:wasm:e2e",
    "test:wasm:full": "npm run test:wasm:unit && npm run test:wasm:e2e && npm run test:wasm:gpu",
    "test:depth:cpu": "node tests/smoke/depth-estimation.cpu.mjs",
    "test:depth:webgpu": "DEPTH_GPU_TESTS=1 playwright test tests/depth-estimation.webgpu.spec.ts --project=chromium",
    "bucket:sync": "node scripts/watch-bucket-simple.js",
    "bucket:watch": "node scripts/watch-bucket-simple.js --watch",
    "bucket:sync-full": "node scripts/watch-bucket.js",
    "bucket:watch-full": "node scripts/watch-bucket.js --watch",
    "audit:shaders": "bash scripts/wgsl-audit-swarm.sh 4",
    "thumbs:generate": "node scripts/generate-shader-thumbnails.js --engine=app --category=all-catalog --missing --priority=attract",
    "thumbs:generate:minimal": "node scripts/generate-shader-thumbnails.js --engine=minimal --category=generative --missing",
    "thumbs:status": "node scripts/thumbnail-coverage-status.js",
    "thumbs:stale": "node scripts/generate-shader-thumbnails.js --engine=app --category=all-catalog --stale",
    "thumbs:backfill-hashes": "node scripts/thumbs-backfill-source-hashes.js",
    "build:source-hashes": "node scripts/build-shader-source-hashes.js",
    "upgrades:record": "node scripts/record-shader-upgrades.js",
    "thumbs:test": "node --test scripts/generate-shader-thumbnails.test.js scripts/check-thumbnail-coverage.test.js scripts/defer-thumbnail.test.js scripts/verify-thumbs-deferrals.test.js scripts/shader-upgrade-tracking.test.js && python3 scripts/test_audit_thumbnail_integrity.py",
    "verify:thumbs-deferrals": "node scripts/verify-thumbs-deferrals.js",
    "thumbs:check-regression": "node scripts/check-thumbnail-coverage.js",
    "verify:device-policy": "node scripts/verify-device-policy-sync.js",
    "verify:wasm-invariants": "node scripts/verify-device-policy-sync.js --wasm-invariants",
    "verify:uniforms": "node scripts/verify-uniforms-layout.js",
    "verify:bundle-size": "node scripts/check-bundle-size.mjs",
    "verify:dependency-boundaries": "node scripts/check-dependency-boundaries.mjs",
    "verify:css": "node scripts/check-css.mjs",
    "verify:shader-list-urls": "node scripts/verify-shader-list-urls.mjs",
    "verify:shader-definitions": "node scripts/validate_shader_definitions.mjs",
    "verify:generated-sync": "node scripts/verify-generated-sync.mjs",
    "generate:shader-definition-types": "node scripts/generate-shader-definition-types.mjs",
    "verify:catalog-counts": "node scripts/verify-catalog-counts.mjs",
    "verify:wasm-bridge-sync": "node scripts/verify-wasm-bridge-sync.mjs",
    "verify:naga-wasm": "node scripts/verify-naga-wasm.mjs",
    "verify:wgsl-include": "node scripts/verify-wgsl-include.mjs",
    "verify:prelude-migration": "python3 scripts/check_prelude_migration.py",
    "shaders:migrate-prelude": "python3 scripts/migrate_to_prelude.py",
    "shaders:libs": "python3 scripts/generate_shader_libs.py && node scripts/emit-wasm-bridge.mjs",
    "verify:naga-wasm:all": "node scripts/verify-naga-wasm.mjs --all",
    "naga-wasm:build": "bash tools/naga_wasm/build.sh",
    "naga-wasm:test": "node --test scripts/verify-naga-wasm.test.mjs",
    "verify:toolchain-foundation": "node scripts/verify-toolchain-foundation.mjs",
    "bench:format-tiers": "playwright test tests/format-tier-bench.spec.ts --project=chromium",
    "audit:shaders:sample": "bash scripts/wgsl-audit-swarm.sh 4 --sample",
    "deploy": "python3 tools/deploy/deploy.py",
    "deploy:app": "python3 tools/deploy/deploy_app_only.py",
    "deploy:full": "SHADER_LIST_BASE_URL=https://test.1ink.us/image_video_effects npm run build && python3 tools/deploy/deploy_app_only.py && python3 tools/deploy/sync_shaders_to_storage.py",
    "sync:shaders": "python3 tools/deploy/sync_shaders_to_storage.py",
    "sync:shaders:dry": "python3 tools/deploy/sync_shaders_to_storage.py --dry-run",
    "swarm:upgrade": "node scripts/run-upgrade-swarm.js",
    "shader:import:gate": "python3 scripts/accept_imported_shader.py",
    "audit:audio-mappings": "python3 scripts/audit_audio_mappings.py",
    "audit:extrabuffer": "python3 scripts/audit_extrabuffer.py",
    "audit:dead-sliders": "python3 scripts/audit_dead_sliders.py",
    "audit:config-y": "python3 scripts/audit_config_y_misuse.py",
    "audit:dead-sliders:generative": "python3 scripts/audit_dead_sliders.py --category generative",
    "gen": "node scripts/buildMultipassRegistry.js && node scripts/generate_shader_lists.js && npm run build:manifest && npm run build:search-index && npm run build:source-hashes",
    "preview": "vite preview",
    "test:ci": "vitest run",
    "typecheck:tests": "tsc -p tests/tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.8",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "@webgpu/types": "^0.1.64",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "3.3.3",
    "sharp": "^0.34.5",
    "tsx": "^4.22.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7",
    "xml2js": "^0.6.2",
    "yaml": "^2.8.2"
  }
}

stylized","artistic","stipple","ink","voronoi","cross-hatch","audio-reactive"],"description":"Weighted Voronoi stippling with Lloyd's relaxation approximation. Dot sizes match local luminance using blue noise distribution. Ink-on-paper aesthetic with dot bleeding, cross-hatching, and ACES tone mapping.","hash":"8ceeb26ec50d1518","embedding":""},{"id":"temporal-echo","name":"Temporal Echo","category":"artistic","tags":["filter","image-processing","audio","music","reactive"],"description":"Feedback buffer and history texture for temporally offset echoes.","hash":"821d0cc73cb53530","embedding":""},{"id":"thermal-vision","name":"Thermal Vision","category":"artistic","tags":["filter","image-processing"],"description":"Heat-signature camera with FBM sensor noise, audio-reactive sensitivity, depth-aware fade, ACES tone mapping, IGN dither, blackbody temperature, split-tone, hue-preserve clamp and vignette.","hash":"1897403425d6ef6d","embedding":""},{"id":"voronoi-dynamics","name":"Voronoi Bubbles","category":"artistic","tags":["geometric","pattern"],"description":"Dynamic Voronoi cells with bubble physics, iridescent edges, and interactive centroids.","hash":"4ede330b5751c1d2","embedding":""},{"id":"voronoi","name":"Voronoi Tessellation","category":"artistic","tags":["geometric","pattern"],"description":"Animated Voronoi reconstruction (simplified feature detection).","hash":"2d68d0bee9a53ad1","embedding":""},{"id":"vortex-prism","name":"Vortex Prism","category":"artistic","tags":["filter","image-processing","audio","music","reactive"],"description":"Twists the image around the mouse cursor, separating colors like a prism.","hash":"eb5a359c0df656bd","embedding":""},{"id":"black-hole","name":"Gravitational Lensing","category":"distortion","tags":["filter","image-processing"],"description":"Stylized gravitational-lensing distortion with held-pointer pull, orbiting horizon runners, inward light packets, audio modulation, and bounded click fronts.","hash":"8a67520ef2f63475","e
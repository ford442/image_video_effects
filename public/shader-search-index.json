","temporal","monte-carlo","global-illumination","ray-marching"],"description":"2D path tracer with temporal accumulation. Casts light rays that bounce off image edges, accumulating Monte Carlo samples over time for soft global illumination and color bleeding.","hash":"0fb40ac8dac9da3d","embedding":""},{"id":"spectral-bleed-confine","name":"Spectral Bleed Confine","category":"advanced-hybrid","tags":["advanced hybrid"],"description":"Spectral Bleed Confine","hash":"32bfb9db13e45335","embedding":""},{"id":"spectral-flow-sorting","name":"Spectral Flow Sorting","category":"advanced-hybrid","tags":["interactive","cursor","audio","music","reactive"],"description":"Optical flow-based pixel sorting with spectral analysis. Pixels flow and sort along motion vectors.","hash":"b56f864eba4462af","embedding":""},{"id":"spectral-flow-structure","name":"Spectral Flow Structure","category":"advanced-hybrid","tags":["structure-tensor","LIC","pixel-sorting","flow","texture-analysis","audio"],"description":"Audio-driven structure-tensor LIC and coherent pixel sorting with sprung mouse vortices, bounded click turbulence, and truthful exact-C Temporal Smoothing through authoritative A display history.","hash":"fcbcfd591e65530e","embedding":""},{"id":"steamy-glass-volumetric","name":"Steamy Glass Volumetric","category":"advanced-hybrid","tags":["steamy-glass","depth-fog","volumetric","mouse-driven"],"description":"Layered steam extinction, droplet scattering, and vertical condensation flow with interactive clearing and chromatic refraction.","hash":"6e96d156970a36fe","embedding":""},{"id":"stellar-plasma-blackbody","name":"Stellar Plasma Blackbody","category":"advanced-hybrid","tags":["blackbody","thermal","plasma","nebula","procedural","cosmic","HDR","physics"],"description":"Cosmic nebula domain-warped FBM blended with Planck's law blackbody thermal coloring. Energy intensity drives temperature mapping — cool voids glow ember-red, hot plasma cores burn blue-white with physically-correct radiance scaling.","hash":"e03041e990c3d12b","embedding":""},{"id":"tensor-flow-morphological","name":"Tensor Flow Morphological","category":"advanced-hybrid","tags":["tensor","warp","morphological","depth-aware","sculpt"],"description":"Depth-aware tensor eigenwarp with morphological post-processing. Erosion darkens compressed tensor regions, dilation brightens tensile regions. Gradient highlights edges created by tensor warping.","hash":"4c25e83a4d10b283","embedding":""},{"id":"thermal-touch-blackbody","name":"Thermal Touch Blackbody","category":"advanced-hybrid","tags":["thermal","blackbody","mouse-driven","stylized","spectral","HDR"],"description":"Mouse-driven thermal camera with a stylized blackbody-inspired palette. Image brightness and the cursor feed an artistic temperature field with buoyant history streaks, click heat fronts, and continuous original-image blending.","hash":"cf063edafb1c268e","embedding":""},{"id":"thermal-vision-blackbody","name":"Thermal Vision Blackbody","category":"advanced-hybrid","tags":["thermal","blackbody","physics","spectral","HDR","mouse-driven"],"description":"Physically-correct thermal vision camera using blackbody radiation via Planck's law. Image luminance maps to real temperature colors, with mouse acting as a localized heat source and configurable sensor contrast.","hash":"989d4e374381acec","embedding":""},{"id":"vaporwave-horizon-prismatic","name":"Vaporwave Horizon Prismatic","category":"advanced-hybrid","tags":["vaporwave-horizon","spectral-dispersion","physical-dispersion","mouse-driven","synthwave","retro"],"description":"Retro-futuristic vaporwave perspective grid with 4-band Cauchy spectral reflection, glowing striped sunset sun, CRT scanlines, ACES tone mapping, and phosphor glow persistence.","hash":"65062d6a48eadf78","embedding":""},{"id":"vhs-tracking-bilateral","name":"VHS Tracking Bilateral","category":"advanced-hybrid","tags":["vhs","retro","bilateral","analog","noise","smoothing"],"description":"VHS signal
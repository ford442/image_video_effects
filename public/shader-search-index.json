":"7e1e565f204320b8","embedding":""},{"id":"photonic-caustics","name":"Photonic Caustics","category":"simulation","tags":["filter","image-processing","caustics","refraction","simulation"],"description":"Exact-history refractive height-field caustics with chromatic convergence bands, Fresnel response, three-band illumination, held light focus, bounded click wavefronts, ACES display, and semantic caustic alpha.","hash":"fbfecbebe2261fe0","embedding":""},{"id":"pixel-sand","name":"Pixel Sand","category":"simulation","tags":["sand","granular","falling","interactive","audio-reactive","particles","simulation","fbm","domain-warp","curl-noise","blackbody","oklab","dither","feedback","temporal-echo","palette"],"description":"Granular density and velocity automaton with avalanche sheets, rising jet lanes, held-pointer gravity, bounded click shelves, three-band spectral heat, depth shading, ACES display, semantic alpha, and raw A-only state feedback.","hash":"d52b1612bf69be55","embedding":""},{"id":"poincare-tiling","name":"Poincaré Tiling","category":"simulation","tags":["poincare","hyperbolic","simulation","physics","showcase"],"description":"Physics Lab — hyperbolic disk tiling with Möbius layer composite. graph · 2 passes.","hash":"8bf2d26b9104e105","embedding":""},{"id":"predator-prey-ecology","name":"Predator-Prey Ecology","category":"simulation","tags":["predator-prey","ecology","simulation","physics","showcase"],"description":"Physics Lab — packed Lotka–Volterra pixels: prey flora vs predator fauna waves. Hold to seed, clicks bloom prey. graph · 2 passes · rgba32float.","hash":"b365ccf51fe482b4","embedding":""},{"id":"predator-prey","name":"Pixel Ecology","category":"simulation","tags":["procedural","generative"],"description":"Cellular-automata food chain of plants, herbivores, and carnivores. Prey lose energy to adjacent predators; animal death composts into plants.","hash":"d8aef18c7d1d3805","embedding":""},{"id":"quantum-foam-pass1","name":"Quantum Foam (Pass 1: Field Generation)","category":"simulation","tags":["quantum","field-generation","noise","simulation"],"description":"Generates quantum probability field with curl noise and FBM. First pass of 3-pass system.","hash":"5f679d716770c085","embedding":""},{"id":"rd-on-video-pass1","name":"RD on Video (Pass 1: State Update)","category":"simulation","tags":["reaction-diffusion","video","luminance","organic","turing"],"description":"Gray-Scott reaction-diffusion seeded and continuously driven by video luminance, with exact-load chemistry, three-band kinetics, held inoculation, click seed fronts, ACES preview, semantic alpha, and A-only state ownership.","hash":"d47b9bdcabb8048c","embedding":""},{"id":"ripple-tank","name":"Ripple Tank","category":"simulation","tags":["wave-equation","interference","caustics","water","simulation","showcase"],"description":"Physics Lab flagship — click for rings, hold for a driven oscillator, audio rains droplets across the tank. 7 graph passes · target 60 fps at balanced.","hash":"497b127cafffdf52","embedding":""},{"id":"sim-decay-system-rgba","name":"Sim: Decay System RGBA","category":"simulation","tags":["simulation","decay","corrosion","interactive","mouse-driven","rgba-state-machine","rust","aging"],"description":"Four-layer material decay simulation with cross-coupling. Paint integrity, metal corrosion, organic rot, and structural integrity each decay at different rates. When one layer fails, others decay faster. Mouse interaction can restore/repair.","hash":"e90eb1bc0a356730","embedding":""},{"id":"sim-decay-system","name":"Decay System","category":"simulation","tags":[],"description":"Multi-layer decay and corrosion simulation. Image corrodes from edges inward with different materials.","hash":"a4e4d3b0e5d095ae","embedding":""},{"id":"sim-fluid-feedback-coupled","name":"Fluid Feedback Coupled","category":"simulation","tags":["fluid","simulation","mouse-driven","interactive","temporal"],"description":"Mouse-steerable coupled fluid simulation combining Navier-Stokes feedback fields with viscous fluid stirring. Mouse drags fluid creating vortex streets; click ripples inject bursts. Fluid thickness drives color absorption, blur, and glow.","hash":"cd34d7507b279de5","embedding":""},{"id":"sim-fluid-feedback-field","name":"Fluid Feedback Field","category":"simulation","tags":[],"description":"Multi-pass Navier-Stokes fluid simulation with feedback trails. Glowing fluid that swirls and mixes.","hash":"bd8e98defe080ab1","embedding":""},{"id":"sim-heat-haze-field","name":"Heat Haze Field","category":"simulation","tags":[],"description":"Temperature simulation with convection currents. Desert mirage effect with rising heat patterns.","hash":"8e1b3fc1c9266bd8","embedding":""},{"id":"sim-ink-diffusion-rgba","name":"Sim: Ink Diffusion RGBA","category":"simulation","tags":["simulation","ink","diffusion","interactive","mouse-driven","rgba-state-machine","artistic","paper"],"description":"Four-ink wet diffusion simulation on paper texture. RGB channels hold cyan, magenta, and yellow pigment concentrations; alpha holds water saturation that drives all diffusion. Pigments mix subtractively on wet paper.","hash":"d9471a410caa4187","embedding":""},{"id":"sim-ink-diffusion","name":"Ink Diffusion","category":"simulation","tags":[],"description":"Fluid ink diffusion with paper absorption. Multi-channel Gray-Scott with Wolfram-validated parameters.","hash":"1b7f4d137f172af6","embedding":""},{"id":"sim-sand-dunes-rgba","name":"Sim: Sand Dunes RGBA","category":"simulation","tags":["simulation","sand","physics","interactive","mouse-driven","rgba-state-machine","wind","erosion"],"description":"Four-population grain simulation packing fine, coarse, moist, and airborne dust fractions in raw A state, with exact-load transport, audio gusts, held deposition, click dust fronts, ACES material color, and semantic coverage alpha.","hash":"6a455f6dbff4f32f","embedding":""},{"id":"sim-sand-dunes","name":"Sand Dunes","category":"simulation","tags":[],"description":"Persistent dune height field with saltation, angle-of-repose avalanches, wind erosion, moisture cohesion, three-band gusts, held sand deposition, bounded click shelves, ACES shading, semantic alpha, and raw A-only state.","hash":"2dc6d57c691bfb87","embedding":""},{"id":"sim-slime-mold-growth-em","name":"Slime Mold Growth + EM Field","category":"simulation","tags":["interactive","mouse-driven","physics","slime","electromagnetic","agents"],"description":"Physarum slime mold simulation with mouse electromagnetic field interaction. Agents steer along electric field lines; click ripples spawn secondary charges.","hash":"ec3f64d32e2ee521","embedding":""},{"id":"sim-slime-mold-growth","name":"Slime Mold Growth","category":"simulation","tags":[],"description":"Physarum-style slime mold with trail following. Branching network of glowing trails exploring space.","hash":"0c341da3a6108d16","embedding":""},{"id":"sim-smoke-trails","name":"Smoke Trails","category":"simulation","tags":[],"description":"Volumetric smoke with vorticity and buoyancy. Billowing smoke rising with natural turbulence.","hash":"670ab41de65d587c","embedding":""},{"id":"sim-volumetric-fake","name":"Volumetric Fake (God Rays)","category":"simulation","tags":[],"description":"Fast approximation of volumetric lighting. Radial blur from light source with depth-based scattering.","hash":"8d5c7801f725d6ac","embedding":""},{"id":"slime-mold-on-video","name":"Slime Mold on Video","category":"simulation","tags":["slime","physarum","video","food-map","tendrils","glow","audio-reactive","depth-aware","chromatic"],"description":"Video luminance feeds a slime-mold trail simulation with velocity-biased history advection, traveling chemotactic pulse packets, and click food fronts. Audio shifts tendril colors, depth boosts glow, and the mouse deposits food.","hash":"02366e37ad505cc8","embedding":""},{"id":"spec-runge-kutta-advection","name":"Runge-Kutta Advection","category":"simulation","tags":["runge-kutta","RK4","fluid","advection","simulation","vortex","temporal"],"description":"4th-order Runge-Kutta fluid advection. Dramatically more accurate than Euler method, preserving fine dye structures 10x longer. Mouse creates counter-rotating vortex pairs.","hash":"9ce2bbc3c4ad2317","embedding":""},{"id":"split-flap-display","name":"Split Flap Display","category":"simulation","tags":["filter","image-processing"],"description":"Simulates a mechanical split-flap display where the image is made of rotating tiles.","hash":"31d2c6e7be163ecf","embedding":""},{"id":"steamy-glass","name":"Steamy Glass","category":"simulation","tags":["simulation","physics"],"description":"Stateful condensation, droplets, and runoff refract a fogged window that can be wiped with held input and disturbed by click fronts.","hash":"822c0609aa1d267f","embedding":""},{"id":"wave-equation","name":"Wave Tank","category":"simulation","tags":["filter","image-processing"],"description":"Psychedelic ripple tank — click to drop interference rings, drag to stir, bass pulses the waves. Rainbow phase bands and caustic sparkles over your image.","hash":"22e4d616cced15ba","embedding":""},{"id":"wave-tank","name":"Wave Tank","category":"simulation","tags":["simulation","wave","ripple","physics"],"description":"Psychedelic 2D wave interference — click to drop ripples, drag to stir, bass pulses the tank. Tier C graph runner demo.","hash":"7a57be3b04d3d5e4","embedding":""},{"id":"alpha-depth-fog-volumetric","name":"Alpha Depth Fog Volumetric","category":"visual-effects","tags":["volumetric","fog","depth-aware","interactive","mouse-driven","rgba-state-machine","atmospheric"],"description":"Seven depth layers accumulate turbulent Beer-Lambert fog with a live warm-to-cool temperature range, audio-lit scattering, held-pointer clearing, and click-driven vortices.","hash":"48772650441cd18e","embedding":""},{"id":"alpha-hdr-bloom-chain","name":"Alpha HDR Bloom Chain","category":"visual-effects","tags":["hdr","bloom","tone-mapping","interactive","mouse-driven","rgba-state-machine","glow"],"description":"Temporal spectral HDR bloom with multi-ring dispersion, exposure-preserving feedback, audio-shaped radiance, held-pointer halos, and expanding click flashes.","hash":"fa2b5bd8da2f2ded","embedding":""},{"id":"alpha-luminance-history","name":"Alpha Luminance History","category":"visual-effects","tags":["temporal","history","luminance","glow","interactive","mouse-driven","rgba-state-machine","light-painting"],"description":"Temporal luminance history with RGB plus rolling luminance in alpha. Slider-controlled diffusion, directional history advection, traveling click rings, and mouse painting create bounded light trails and warm afterimages.","hash":"7f2bc0f6a71d2b6d","embedding":""},{"id":"alpha-multi-layer-glass","name":"Alpha Multi-Layer Glass","category":"visual-effects","tags":["glass","refraction","chromatic","interactive","mouse-driven","rgba-state-machine","fresnel","audio-reactive","roughness"],"description":"Multi-layer glass refraction with RGBA data channels. Simulates looking through 3 layers of procedurally-distorted glass with Fresnel reflection, chromatic aberration, GGX roughness, and per-layer tinting. Alpha stores accumulated transmittance.","hash":"4dbdc87815fa7deb","embedding":""},{"id":"alpha-spectral-decompose","name":"Alpha Spectral Decompose","category":"visual-effects","tags":["spectral","frequency","decomposition","interactive","mouse-driven","rgba-state-machine","filter"],"description":"Decomposes the image into 4 spectral frequency bands stored in RGBA. Low freq (R), mid-low (G), mid-high (B), high freq/detail (A). Recomposes with user-controlled per-band gain for frequency-equalizer style image manipulation.","hash":"537224747d425e75","embedding":""},{"id":"anaglyph-3d","name":"Anaglyph 3D","category":"visual-effects","tags":["anaglyph","3d","depth-aware","stereo","audio-reactive","temporal","chromatic","ghost"],"description":"Red-cyan stereoscopic anaglyph with temporal ghost fringing persistence, chromatic separation enhancement per depth, mouse focal depth curve refinement, bass-pulsed split width, and cinematic post-processing: film grain with temporal coherence, radial chromatic aberration, vignette darkening, CRT barrel distortion, col","hash":"64405f335715946d","embedding":""},{"id":"anamorphic-caustic-flare","name":"Anamorphic Caustic Flare","category":"visual-effects","tags":["anamorphic","caustic","lens-flare","cinematic","refraction","audio-reactive","water"],"description":"Premium cinematic anamorphic lens flares combined with living, refracting water caustics that distort and project the source footage. Bass stretches the flares dramatically while treble animates the caustic ripples. Mouse tilts the virtual lens.","hash":"f388394919729771","embedding":""},{"id":"ascii-shockwave","name":"ASCII Shockwave","category":"visual-effects","tags":["filter","image-processing"],"description":"Matrix glyph cells with traveling shock packets, held-pointer ASCII density, bounded click rings, and oil-slick phosphor color. Display RGBA is packed in A.","hash":"42dbdd48536bf846","embedding":""},{"id":"breathing-kaleidoscope","name":"Breathing Kaleidoscope","category":"visual-effects","tags":["kaleidoscope","petals","audio","reactive","organic","fbm"],"description":"Organic breathing kaleidoscope driven by domain-warped FBM, fractional symmetry, jewel-tone palette cycling, film grain, and depth-aware sector fading.","hash":"9315c395418a3c99","embedding":""},{"id":"chroma-vortex","name":"Chroma Vortex","category":"visual-effects","tags":["vfx","particles","glow","audio","music"],"description":"Rotational RGB splitting effect centered on the mouse.","hash":"7b54f15158fa3055","embedding":""},{"id":"chromatic-focus-interactive","name":"Chromatic Focus","category":"visual-effects","tags":["vfx","particles","glow"],"description":"Chromatic DOF with six-blade iris geometry, multi-tap blur, zone-plate caustics, oil-slick runners/packets, held focus squeeze/pinch, click iris shells, and light display history in A.","hash":"2870c47c3d6a3b3e","embedding":""},{"id":"cross-spec-alpha-spectral-bloom","name":"Spectral Bloom HDR","category":"visual-effects","tags":["crossover","spectral","bloom","hdr","rgba-as-data","chromatic"],"description":"Crossover shader combining spectral dispersion with HDR bloom using RGBA as independent spectral bands. Decomposes the image into wavelength channels and applies per-band bloom with exposure control in alpha.","hash":"83f24522273ce0f4","embedding":""},{"id":"crt-clear-zone","name":"CRT Clear Zone","category":"visual-effects","tags":["crt","retro","electron-beam","shadow-mask","temporal","image-processing"],"description":"Accurate CRT electron beam simulation with Gaussian spot spread, inline shadow mask, phosphor decay via temporal feedback, barrel distortion with corner darkening, per-RGB chromatic aberration, and ACES tone mapping.","hash":"611fdbdd7e82136c","embedding":""},{"id":"cyber-grid-pulse","name":"Cyber Grid Pulse","category":"visual-effects","tags":["vfx","particles","glow"],"description":"","hash":"a3c6aef40b0ef2f8","embedding":""},{"id":"cyber-physical-portal","name":"Cyber Physical Portal","category":"visual-effects","tags":["portal","cyber","swirl","grid","audio-reactive","lensing","hologram","chromatic"],"description":"Upgraded cyber portal with event-horizon frame dragging, gravitational lensing, accretion disk bands, cyan-magenta holographic rim, chromatic aberration, and HDR bloom. Bass drives spin, mouse positions portal, depth controls lensing.","hash":"9aaeb63c8a7c37a4","embedding":""},{"id":"cyber-scan","name":"Cyber Scan","category":"visual-effects","tags":["cyber","scan","hud","glow","audio-reactive","depth-aware","chromatic","temporal","holographic","hex-grid","interference","binary-rain"],"description":"A digital scanning ecosystem with triple-layer scan lines, holographic interference patterns, hex-grid data visualization, binary rain effects, and FBM noise corruption. Depth-based colorization with chromatic RGB separation driven by treble intensity.","hash":"1ba3a013b4db4bfa","embedding":""},{"id":"data-scanner","name":"Data Scanner","category":"visual-effects","tags":["vfx","particles","glow"],"description":"","hash":"50843ae1d4d07d96","embedding":""},{"id":"elastic-chromatic","name":"Elastic Chromatic","category":"visual-effects","tags":["filter","chromatic","lag","elastic","lissajous","mouse-driven","hdr","dither","split-tone","alpha-layered","luminance-key"],"description":"Elastic chromatic aberration with radial RGB shift, per-channel temporal lag, Lissajous mouse source, depth-aware audio reactivity, split-tone blackbody grading, ACES tone mapping, IGN dither and advanced layered alpha compositing.","hash":"35ae661a3a03060d","embedding":""},{"id":"electric-contours","name":"Electric Contours","category":"visual-effects","tags":["filter","image-processing","electric-field","equipotential","dielectric","corona","plasma-glow","hdr-bloom","aces-tone-mapping","audio-reactive","mouse-driven","spark-charges"],"description":"Electric field line tracing with equipotential surfaces, capped click spark charges from ripples, held mouse charge boost, corona bloom packets, FFT band arcs, and treble sparkle. Display is ACES-tonemapped; A stores raw field diagnostics (potential, |E|, edge/spark, dielectric energy).","hash":"f709abd355feebdb","embedding":""},{"id":"glitch-pixel-sort","name":"Glitch Pixel Sort","category":"visual-effects","tags":["filter","image-processing"],"description":"Luminance-based pixel stretching controlled by mouse position.","hash":"e33303ca50b3d030","embedding":""},{"id":"hex-circuit","name":"Hex Circuit","category":"visual-effects","tags":["vfx","particles","glow"],"description":"Overlays a cybernetic hexagonal grid that highlights image edges and reacts to mouse pulses.","hash":"d9b3c46b78832197","embedding":""},{"id":"holographic-flicker","name":"Holographic Flicker","category":"visual-effects","tags":["hologram","flicker","glitch","ghost","audio-reactive","depth-aware","chromatic","temporal"],"description":"Holographic flicker with temporal ghosting and depth-rainbow colorization. Bass drives blackout probability, treble adds micro-glitch. Chromatic ghosting separates RGB channels across frames.","hash":"1de51adfb016482f","embedding":""},{"id":"holographic-projection-gpt52","name":"Holo Projection Prism gpt52","category":"visual-effects","tags":["vfx","particles","glow","audio","music","hologram","bragg","diffraction"],"description":"Prismatic volume hologram with Bragg diffraction physics, stabilized focus, scan interference, and spectral tinting.","hash":"cacf1195aa760c28","embedding":""},{"id":"holographic-projection","name":"Holo Projector","category":"visual-effects","tags":["vfx","particles","glow","audio","music","reactive"],"description":"Transforms the image into a flickering hologram. Move mouse to focus and stabilize the projection.","hash":"7d321b62185e7a03","embedding":""},{"id":"holographic-sticker","name":"Holographic Sticker","category":"visual-effects","tags":["vfx","particles","glow","audio","music","holographic","sticker","chromatic","temporal","iridescent"],"description":"Mouse-centered iridescent sticker with chromatic view-angle dispersion, temporal foil shimmer persistence, audio-driven sticker pulse, depth-layered alpha, and rainbow phase shift.","hash":"747d083e9559baa4","embedding":""},{"id":"hyper-space-jump","name":"Hyper Space Jump","category":"visual-effects","tags":["hyperspace","fast-motion","relativistic","interactive"],"description":"Continuous relativistic streak integration combines a Doppler palette, helical flight, a movable vanishing point, held acceleration, and age-bounded jump shocks.","hash":"a72cb2495ee949ef","embedding":""},{"id":"interactive-fresnel","name":"Interactive Fresnel","category":"visual-effects","tags":["filter","image-processing","audio","music","reactive","fresnel","lensing","chromatic","temporal"],"description":"2.5D Fresnel lens curvature with Cauchy dispersion, held ring squeeze, oil-slick grout, radial packets, and bounded click shells. Display RGBA in A.","hash":"da425180f2138ee6","embedding":""},{"id":"interactive-pcb-traces","name":"Interactive PCB Traces","category":"visual-effects","tags":["pcb","circuit","signals","interactive"],"description":"Coherent Manhattan routes connect pads and vias while signal packets, persistent trace glow, pointer injection, held drive, and click propagation animate the board.","hash":"a88d3d4e3edb0371","embedding":""},{"id":"luma-smear-interactive","name":"Kinetic Echo","category":"visual-effects","tags":["filter","image-processing","smear","echo","audio-reactive","depth-aware","chromatic","curl-noise","fast-motion","aces"],"description":"Chromatic R-lag / B-lead streaks with curl-advected exact-C trails. Trail Decay, luma gate, color shift, and mouse eraser stay live. ACES display history with trail-energy alpha.","hash":"5056fa7b05e38d80","embedding":""},{"id":"neon-edge-glow","name":"Neon Edge Glow","category":"visual-effects","tags":["neon","edge","glow","bloom","sobel","gas-discharge","spectrum","colorful","post-processing","audio-reactive","depth-aware"],"description":"Gas discharge tube simulation with accurate neon emission spectrum, AC rectification flicker, mercury vapor secondary lines, electrode sputtering, and atmospheric haze. Bass drives flicker frequency, mouse bends the tube, depth controls atmospheric scatter.","hash":"5e92f5f20edf434c","embedding":""},{"id":"neon-edge-pulse","name":"Neon Edge Pulse","category":"visual-effects","tags":["vfx","particles","glow","audio","music","reactive","alpha","edge-preserve"],"description":"Detects edges and highlights them with pulsing neon colors. Mouse proximity increases intensity.","hash":"b5ebb8d0a2c74c27","embedding":""},{"id":"neon-edge-reveal","name":"Neon Edge Reveal","category":"visual-effects","tags":["filter","image-processing","audio","music","reactive"],"description":"Neon edge detection with interactive flashlight reveal.","hash":"cc74ca31dbaa6222","embedding":""},{"id":"neon-topology","name":"Neon Topology","category":"visual-effects","tags":["vfx","particles","glow","audio","music","reactive"],"description":"Renders the image as a glowing 3D topographic map.","hash":"0f2f5c7b2f317140","embedding":""},{"id":"phantom-lag","name":"Phantom Lag","category":"visual-effects","tags":["filter","image-processing"],"description":"Creates trailing echoes of movement with chromatic multi-tap delays, spring-damper bass smoothing, and velocity-stretched cursor ghosts.","hash":"01e6c5f293d14b2d","embedding":""},{"id":"pixel-sorter","name":"Pixel Sorter","category":"visual-effects","tags":["filter","image-processing","audio","music","reactive"],"description":"Glitch art pixel sorting with alpha translucency blending. Single sort pass with spectral tinting, depth-aware compositing, and audio-reactive shimmer.","hash":"00dd6bd35833552a","embedding":""},{"id":"quantum-field-visualizer","name":"Quantum Field Visualizer","category":"visual-effects","tags":["vfx","quantum","interference","glow","hdr","abstract"],"description":"Complex wavefunction visualization with real/imaginary parts mapped to hue, probability density to brightness, and phase to saturation. Features two-slit interference, Gaussian packet spreading, and mouse-driven quantum measurement collapse.","hash":"f153155493f4491d","embedding":""},{"id":"quantum-ghost","name":"Quantum Ghost","category":"visual-effects","tags":["quantum","ghost","interference","fringes","temporal","mouse-driven","audio-reactive","depth-aware","chromatic","wave-packet","entanglement","hdr-bloom","aces-tone-mapping"],"description":"Quantum uncertainty visualization with Gaussian wave packet spreading, interference patterns from partial measurement, and entanglement correlation lines between ghost copies. Ghostly translucent copies with phase-dependent opacity, neon quantum numbers, HDR bloom on measurement events, ACES tone mapping, and chromatic","hash":"96c4b57f04de1829","embedding":""},{"id":"rgb-distance-split","name":"RGB Distance Split","category":"visual-effects","tags":["vfx","particles","glow"],"description":"Chromatic aberration that intensifies with distance from the mouse.","hash":"35c6d330a22278cc","embedding":""},{"id":"rgb-topology","name":"RGB Topology","category":"visual-effects","tags":["topology","contour","rgb","depth-aware","audio-reactive","hypsometric","3d-terrain","hdr-specular"],"description":"Topographic contour extraction per RGB channel with index isolines, ridge ticks, traveling iso-runners, psychedelic hypsometric ramps, held shear, and bounded click fronts. Feedback A stays [lineR, lineG, lineB, alpha].","hash":"8417431e1815e1be","embedding":""},{"id":"signal-modulation","name":"Signal Modulation","category":"visual-effects","tags":["filter","image-processing","signal","carrier","fft"],"description":"AM/FM carrier wave with sprung origin, held widen, capped click carrier bursts, honest regional FFT spectral bands, ACES composite.","hash":"cc4ef63693b372f2","embedding":""},{"id":"spectral-rain","name":"Spectral Rain","category":"visual-effects","tags":["rain","chromatic","distortion","filter","image-processing","audio-reactive"],"description":"Falling streaks of chromatic distortion with audio-reactive intensity and mouse-driven angle and speed controls.","hash":"712e6077ab831916","embedding":""},{"id":"temporal-rgb-smear","name":"Temporal RGB Smear","category":"visual-effects","tags":["filter","image-processing","audio-reactive","interactive","temporal","feedback","chromatic","curl-noise","domain-warp","depth-aware","tone-mapping","alpha-layered","luminance-key","edge-preserve","accumulative"],"description":"Directional RGB smear with curl-noise velocity field, domain-warped drift, Halton-jittered chromatic sampling, temporal feedback decay, ACES tone mapping, and advanced layered alpha compositing (luminance key, edge preserve, effect intensity, depth layer, accumulative trails).","hash":"fd5bc28cd6232b88","embedding":""},{"id":"time-slit-scan","name":"Time Slit Scan","category":"visual-effects","tags":["slit-scan","temporal","artistic","time-warp"],"description":"Multi-slit temporal scan with curved parametric slits, polar drift, and time-warp color tinting.","hash":"a3eab555d7f4d837","embedding":""},{"id":"voxel-grid","name":"Voxel Grid","category":"visual-effects","tags":["vfx","particles","glow","audio-reactive"],"description":"Transforms the image into a grid of rotating 3D voxels that react to mouse proximity and audio bass.","hash":"ac90018d80bf57dc","embedding":""},{"id":"warp-drive","name":"Warp Drive","category":"visual-effects","tags":["warp","streak","space","chromatic","audio-reactive","doppler","relativistic","alcubierre"],"description":"Alcubierre warp streaks with Doppler aurora packets, held warp aim, analytic stars, click fronts. Diagnostic A packing preserved.","hash":"de7bd35f0b802e2c","embedding":""},{"id":"zipper-reveal","name":"Zipper Reveal","category":"visual-effects","tags":["zipper","fashion","reveal","metal","fabric","chromatic","audio-reactive"],"description":"Mechanical zipper with interlocking tooth simulation, fabric physics, metallic specular highlights, and chromatic aberration on fast-moving teeth. Bass drives zipper speed and mouse controls pull position.","hash":"c8994e913d27a7c2","embedding":""}]}

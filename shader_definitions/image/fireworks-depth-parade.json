{
  "id": "fireworks-depth-parade",
  "name": "4th of July \u2014 Depth Parade",
  "url": "shaders/fireworks-depth-parade.wgsl",
  "description": "Depth layers of your image launch fireworks in parade sequence \u2014 foreground detonates first, then midground, then background. Creates a cinematic 3D-ish celebration where near elements pop before far ones. Image colors tint each layer's shells. Bass amplifies foreground launches. Mouse triggers a depth-sorted barrage.",
  "tags": [
    "fireworks",
    "depth",
    "parade",
    "layered",
    "pyrotechnics",
    "july-4",
    "image-reactive",
    "audio-reactive",
    "4th-of-july"
  ],
  "features": [
    "audio-reactive",
    "temporal",
    "semantic-alpha",
    "depth-aware"
  ],
  "params": [
    {
      "id": "layers",
      "name": "Layer Separation",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "id": "speed",
      "name": "Launch Speed",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "id": "boost",
      "name": "Depth Boost",
      "default": 0.6,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "id": "trail",
      "name": "Trail Length",
      "default": 0.45,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    }
  ]
}

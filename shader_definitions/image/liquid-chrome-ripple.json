{
  "id": "liquid-chrome-ripple",
  "name": "Liquid Chrome Ripple",
  "url": "shaders/liquid-chrome-ripple.wgsl",
  "description": "A capillary chrome sheet with pointer and click wave trains, derivative normals, RGB refraction, thin-film reflection, dual-lobe highlights, caustics, and advected metallic afterimages.",
  "params": [
    {
      "id": "flow",
      "name": "Flow Speed",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "distort",
      "name": "Distortion",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "metal",
      "name": "Metalness",
      "default": 0.8,
      "min": 0,
      "max": 1
    },
    {
      "id": "freq",
      "name": "Ripple Freq",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "click-reactive",
    "audio-reactive",
    "temporal",
    "depth-aware",
    "pbr-chrome",
    "capillary-waves",
    "chromatic-dispersion",
    "aces-tone-map"
  ],
  "tags": [
    "filter",
    "image-processing"
  ]
}

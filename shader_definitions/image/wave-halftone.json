    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba"
  ],
  "params": [
    {
      "id": "size",
      "name": "Dot Size",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "density",
      "name": "Grid Density",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "amp",
      "name": "Wave Amp",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "speed",
      "name": "Wave Speed",
      "default": 0.2,
      "min": 0,
      "max": 1
    }
  ],

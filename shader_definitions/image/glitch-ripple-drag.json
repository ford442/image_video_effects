{
  "id": "glitch-ripple-drag",
  "url": "shaders/glitch-ripple-drag.wgsl",
  "name": "Glitch Ripple Drag",
  "description": "Spring cursor emits expanding quantized ripple rings that permanently drag and chromatically glitch pixels with exact C feedback, capped click ripples, and audio.",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "click-ripples",
    "held-drag",
    "stateful",
    "upgraded-rgba",
    "aces-tone-map"
  ],
  "workgroup_size": [16, 16, 1],
  "params": [
    {
      "id": "drag",
      "name": "Drag Strength",
      "type": "float",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "mapping": "zoom_params.x"
    },
    {
      "id": "freq",
      "name": "Ripple Freq",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "mapping": "zoom_params.y"
    },
    {
      "id": "persist",
      "name": "Persistence",
      "type": "float",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "mapping": "zoom_params.z"
    },
    {
      "id": "glitch",
      "name": "Glitch Factor",
      "type": "float",
      "default": 0,
      "min": 0,
      "max": 1,
      "mapping": "zoom_params.w"
    }
  ],
  "updatedParams": [
    { "index": 0, "name": "Drag Strength", "default": 0.5, "min": 0, "max": 1 },
    { "index": 1, "name": "Ripple Freq", "default": 0.3, "min": 0, "max": 1 },
    { "index": 2, "name": "Persistence", "default": 0.8, "min": 0, "max": 1 },
    { "index": 3, "name": "Glitch Factor", "default": 0, "min": 0, "max": 1 }
  ],
  "tags": [
    "filter",
    "image-processing",
    "glitch",
    "temporal"
  ]
}

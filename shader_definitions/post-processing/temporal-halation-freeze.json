{
  "id": "temporal-halation-freeze",
  "name": "Temporal Halation Freeze",
  "url": "shaders/temporal-halation-freeze.wgsl",
  "description": "Long-exposure halation and ghost echoes using a 7-tap hex-bokeh bloom, audio envelope, ACES tone mapping, depth-aware fog, and semantic alpha for dreamy time-blurred composites.",
  "tags": [
    "halation",
    "bloom",
    "long-exposure",
    "temporal",
    "ghost",
    "cinematic",
    "audio-reactive"
  ],
  "features": [
    "audio-reactive",
    "audio-driven",
    "temporal",
    "semantic-alpha",
    "depth-aware",
    "upgraded-rgba"
  ],
  "workgroup_size": [16, 16, 1],
  "params": [
    {
      "id": "exposure",
      "name": "Exposure Length",
      "default": 0.7,
      "min": 0.0,
      "max": 1.5,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "Length of the halation exposure"
    },
    {
      "id": "decay",
      "name": "Decay Rate",
      "default": 0.86,
      "min": 0.6,
      "max": 0.97,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Temporal decay rate"
    },
    {
      "id": "color_temp",
      "name": "Bloom Color Temp",
      "default": 0.35,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "Warm/cool bloom tint"
    },
    {
      "id": "ghost",
      "name": "Ghost Echo",
      "default": 0.55,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Ghost echo strength"
    }
  ]
}

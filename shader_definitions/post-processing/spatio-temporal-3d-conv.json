{
  "id": "spatio-temporal-3d-conv",
  "name": "Spatio-Temporal 3D Convolution",
  "url": "shaders/spatio-temporal-3d-conv.wgsl",
  "category": "post-processing",
  "description": "3×3×T spatio-temporal convolution over the history ring: grain-preserving denoise, long-exposure motion blur, or colour-coded temporal sharpening.",
  "tags": [
    "temporal",
    "convolution",
    "noise-reduction",
    "motion-blur",
    "sharpening",
    "3d-kernel",
    "spatio-temporal"
  ],
  "features": [
    "temporal",
    "history-ring",
    "advanced-convolution",
    "audio-reactive",
    "upgraded-rgba",
    "spatio-temporal"
  ],
  "requiresHistoryRing": true,
  "params": [
    {
      "id": "spatial_sigma",
      "name": "Spatial Sigma",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "temperature_depth",
      "name": "Temperature Depth",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "mode",
      "name": "Mode",
      "default": 0.0,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "labels": [
        "Denoise",
        "Motion Blur",
        "Sharpen"
      ]
    },
    {
      "id": "strength",
      "name": "Strength",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  ]
}

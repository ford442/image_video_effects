    "timescale",
    "psychedelic",
    "rainbow",
    "motion"
  ],
  "features": [
    "temporal",
    "history-ring",
    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba",
    "click-reactive"
  ],
  "requiresHistoryRing": true,

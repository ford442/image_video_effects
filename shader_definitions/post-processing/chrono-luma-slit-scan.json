{
  "id": "chrono-luma-slit-scan",
  "name": "Chrono Luma Slit Scan",
  "url": "shaders/chrono-luma-slit-scan.wgsl",
  "category": "post-processing",
  "description": "Luminance slit-scan with horizontal/vertical scan runners, a raised-cosine shutter between frames, and a short smear along the slit's travel. Thin isochrone contours mark where the chosen age crosses a whole frame, and the sweeping scan bands open windows onto the oldest stored frame; each runner now drags a fading wake behind it, and dark regions read as a long exposure that integrates the span of frames instead of a single frozen one.",
  "tags": [
    "temporal",
    "slit-scan",
    "chrono",
    "luminance",
    "history",
    "time",
    "psychedelic",
    "abstract"
  ],
  "features": [
    "temporal",
    "history-ring",
    "audio-reactive",
    "mouse-driven",
    "click-reactive"
  ],
  "requiresHistoryRing": true,
  "params": [
    {
      "id": "temporal_spread",
      "name": "Temporal Spread",
      "default": 1.0,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "warp_strength",
      "name": "Warp Strength",

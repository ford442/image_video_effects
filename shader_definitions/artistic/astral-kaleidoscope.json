      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "rotation_speed",
      "name": "Rotation Speed",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "spiral_strength",
      "name": "Spiral Strength",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "trail_persistence",
      "name": "Trail Persistence",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  ]

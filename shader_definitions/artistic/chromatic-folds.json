      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "pivot_hue",
      "name": "Pivot Hue",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "sat_scale",
      "name": "Sat Scale",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "depth_influence",
      "name": "Depth Influence",

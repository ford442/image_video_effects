{
  "id": "neon-edge-diffusion",
  "name": "Neon Edge Diffusion",
  "url": "shaders/neon-edge-diffusion.wgsl",
  "description": "Shared-memory Sobel edge detection with hex-bokeh neon glow, ACES tone mapping, and semantic alpha emission.",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "audio-driven",
    "upgraded-rgba"
  ],
  "workgroup_size": [16, 16, 1],
  "tags": [
    "filter",
    "image-processing",
    "audio",
    "music"
  ],
  "params": [
    {
      "id": "glow_intensity",
      "name": "Glow Intensity",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "Overall neon glow intensity"
    },
    {
      "id": "bloom_radius",
      "name": "Bloom Radius",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Hex bokeh diffusion radius"
    },
    {
      "id": "ripple_strength",
      "name": "Ripple Strength",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "Audio-reactive ripple contribution"
    },
    {
      "id": "color_shift",
      "name": "Color Shift",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Neon hue shift amount"
    }
  ]
}

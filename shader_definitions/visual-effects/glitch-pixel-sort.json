{
  "id": "glitch-pixel-sort",
  "name": "Glitch Pixel Sort",
  "url": "shaders/glitch-pixel-sort.wgsl",
  "description": "Luminance-based pixel stretching controlled by mouse position.",
  "params": [
    {
      "id": "threshold",
      "name": "Threshold",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "mode",
      "name": "Sort Mode",
      "default": 0.0,
      "min": 0,
      "max": 2,
      "step": 1,
      "mapping": "zoom_params.y"
    },
    {
      "id": "glitch",
      "name": "Glitch Amount",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z"
    }
  ],
  "features": [
    "mouse-driven"
  ],
  "tags": [
    "filter",
    "image-processing"
  ]
}
      "max": 1
    },
    {
      "id": "amp",
      "name": "Distortion Amt",
      "type": "float",
      "default": 0.1,
      "min": 0,
      "max": 1
    },
    {
      "id": "speed",
      "name": "Scroll Speed",
      "type": "float",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "id": "shift",
      "name": "Color Split",
      "type": "float",
      "default": 0.2,
      "min": 0,
      "max": 1
    }
  ],
  "tags": [

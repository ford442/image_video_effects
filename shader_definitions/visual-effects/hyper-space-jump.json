      "max": 1,
      "step": 0.01
    },
    {
      "id": "streak_decay",
      "name": "Streak Decay",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "chromatic_spread",
      "name": "Chromatic Spread",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "vignette_size",
      "name": "Vignette Size",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  ]
}

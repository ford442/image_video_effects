  "description": "Streaks the image radially from the mouse position, simulating a hyperspace jump.",
  "features": [
    "mouse-driven"
  ],
  "tags": [
    "filter",
    "image-processing"
  ],
  "params": [
    {
      "id": "jump_strength",
      "name": "Jump Strength",

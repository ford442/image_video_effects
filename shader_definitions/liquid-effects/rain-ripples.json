{
  "id": "rain-ripples",
  "name": "Rain Ripples",
  "category": "liquid-effects",
  "type": "compute",
  "url": "shaders/rain-ripples.wgsl",
  "description": "Rain-driven ripple packets with bounded pointer wakes, held water push, exact-load HDR persistence, FBM micro-ripples, Voronoi drops, three-band caustics and thin-film color, ACES, and semantic alpha.",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba",
    "depth-aware",
    "voronoi-raindrops",
    "caustics",
    "thin-film-interference",
    "held-interaction",
    "click-reactive",
    "spring-interaction",
    "temporal",
    "exact-load-feedback",
    "aces-tone-map",
    "semantic-alpha"
  ],
  "tags": [
    "filter",
    "image-processing",
    "liquid",
    "ripples"
  ],
  "workgroup_size": [16, 16, 1],
  "params": [
    {
      "id": "intensity",
      "name": "Intensity",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "Overall ripple displacement and depth-fog influence"
    },
    {
      "id": "speed",
      "name": "Speed",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Ripple propagation speed"
    },
    {
      "id": "scale",
      "name": "Scale",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "FBM micro-ripple spatial scale"
    },
    {
      "id": "detail",
      "name": "Detail",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Wave sharpness and chromatic aberration amount"
    }
  ],
  "supportsDepth": true,
  "supportsDof": false,
  "updated": true
}

{
  "id": "liquid-jelly",
  "name": "Liquid Jelly",
  "url": "shaders/liquid-jelly.wgsl",
  "description": "Spring-damped jelly deformation with bounded pointer inertia, exact-load thickness slopes, soft recovery, subsurface scattering, three-band audio, click waves, ACES output, and semantic alpha.",
  "features": [
    "audio-reactive",
    "depth-aware",
    "elastic-bounce",
    "mouse-driven",
    "click-reactive",
    "spring-interaction",
    "exact-load-feedback",
    "aces-tone-map",
    "semantic-alpha",
    "subsurface-scattering",
    "temporal",
    "upgraded-rgba",
    "volume-shading",
    "fast-motion",
    "psychedelic"
  ],
  "tags": [
    "filter",
    "image-processing",
    "liquid"
  ],
  "params": [

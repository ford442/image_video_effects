{
  "id": "liquid-jelly",
  "name": "Liquid Jelly",
  "url": "shaders/liquid-jelly.wgsl",
  "description": "Coral/aqua bioluminescent Kelvin–Voigt jelly with layered gelatin lobes, traveling soliton ridges, fast shear, sharp subsurface highlights, and bounded advected trails.",
  "features": [
    "audio-reactive",
    "depth-aware",
    "elastic-bounce",
    "mouse-driven",
    "subsurface-scattering",
    "temporal",
    "upgraded-rgba",
    "volume-shading",
    "soliton-ridges",
    "exact-feedback"
  ],
  "tags": [
    "filter",
    "image-processing",
    "liquid"
  ],

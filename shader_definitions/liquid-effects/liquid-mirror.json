      "name": "Smoothness",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "reflect",
      "name": "Reflectivity",
      "default": 0.8,
      "min": 0,
      "max": 1
    },
    {
      "id": "push",
      "name": "Push Size",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "held-interaction",
    "click-reactive",
    "audio-reactive",
    "depth-aware",
    "stateful-simulation",
    "raw-height-velocity-state",

{
  "id": "optical-flow-dream",
  "name": "Optical Flow Dream",
  "url": "shaders/optical-flow-estimate.wgsl",
  "description": "Physics Lab — history-ring optical flow (binding 13) with controlled decay and chroma smear. Hold freezes time, clicks tear. graph · 4 passes · battery OK.",
  "requiresRgba32Float": true,
  "requiresHistoryRing": true,
  "multipass": {
    "graph": {
      "maxPassesPerFrame": 8,
      "nodes": [
        { "id": "flow", "entry": "optical-flow-estimate", "reads": ["dataC"], "writes": ["dataA"] },
        { "id": "advect", "entry": "optical-flow-advect", "reads": ["dataC"], "writes": ["dataA"], "repeat": 2 },
        { "id": "grade", "entry": "optical-flow-grade", "reads": ["dataC"], "writes": ["color", "dataA"] }
      ]
    }
  },
  "params": [
    {
      "id": "flowScale",
      "name": "Flow Scale",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "Optical-flow displacement gain from the history ring"
    },
    {
      "id": "decay",
      "name": "Decay",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Dream persistence — higher holds trails longer (bass lifts)"
    },
    {
      "id": "chromaSmear",
      "name": "Chroma Smear",
      "default": 0.45,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "RGB split along the flow field"
    },
    {
      "id": "dreamMix",
      "name": "Dream Mix",
      "default": 0.75,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Blend between live input and advected dream"
    }
  ],
  "features": [
    "simulation",
    "multi-pass",
    "graph-runner",
    "physics",
    "mouse-driven",
    "audio-reactive",
    "interactive"
  ],
  "tags": [
    "optical-flow",
    "feedback",
    "history-ring",
    "simulation",
    "showcase"
  ]
}

{
  "id": "fabric-of-reality",
  "name": "Fabric of Reality",
  "url": "shaders/fabric-verlet.wgsl",
  "description": "Living mass-spring cloth — hold to tear, release to watch Self Heal knit seams. Bass breathes the drape; mouse spotlight rides the weave. Tier C graph · 7 passes.",
  "requiresRgba32Float": true,
  "multipass": {
    "graph": {
      "maxPassesPerFrame": 10,
      "nodes": [
        {
          "id": "verlet",
          "entry": "fabric-verlet",
          "reads": ["dataC"],
          "writes": ["dataA"]
        },
        {
          "id": "constraint",
          "entry": "fabric-constraint",
          "reads": ["dataC"],
          "writes": ["dataA"],
          "repeat": 4
        },
        {
          "id": "tear",
          "entry": "fabric-tear",
          "reads": ["dataA"],
          "writes": ["dataB"]
        },
        {
          "id": "render",
          "entry": "fabric-render",
          "reads": ["dataA"],
          "writes": ["color", "dataA"]
        }
      ]
    }
  },
  "params": [
    {
      "id": "stiffness",
      "name": "Stiffness",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "Spring constraint strength (soft-capped for stable 4-iter Jacobi)"
    },
    {
      "id": "tearThreshold",
      "name": "Tear Threshold",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "How far springs stretch before they tear — lower tears easier"
    },
    {
      "id": "gravity",
      "name": "Gravity",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "Downward drape bias (soft curve — no explode at max)"
    },
    {
      "id": "selfHeal",
      "name": "Self Heal",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Broken springs slowly reconnect when elevated; full heal above ~0.7"
    }
  ],
  "features": [
    "simulation",
    "multi-pass",
    "graph-runner",
    "physics",
    "mouse-driven",
    "audio-reactive",
    "interactive"
  ],
  "tags": [
    "cloth",
    "fabric",
    "simulation",
    "physics",
    "showcase"
  ]
}

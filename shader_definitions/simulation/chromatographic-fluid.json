{
  "id": "chromatographic-fluid",
  "name": "Chromatographic Fluid",
  "url": "shaders/chromatographic-force.wgsl",
  "description": "Physics Lab — RGB dyes with distinct viscosity in a shared wind field. Hold to paint, click solvent splashes, audio gusts. graph · 7 passes · rgba32float.",
  "requiresRgba32Float": true,
  "multipass": {
    "graph": {
      "maxPassesPerFrame": 8,
      "nodes": [
        { "id": "force", "entry": "chromatographic-force", "reads": ["dataC"], "writes": ["dataA"] },
        { "id": "advect", "entry": "chromatographic-advect", "reads": ["dataC"], "writes": ["dataA"] },
        { "id": "diffuse", "entry": "chromatographic-diffuse", "reads": ["dataC"], "writes": ["dataA"], "repeat": 2 },
        { "id": "interact", "entry": "chromatographic-interact", "reads": ["dataC"], "writes": ["dataA"] },
        { "id": "phase", "entry": "chromatographic-phase", "reads": ["dataC"], "writes": ["dataA"] },
        { "id": "render", "entry": "chromatographic-render", "reads": ["dataC"], "writes": ["color", "dataA"] }
      ]
    }
  },
  "params": [
    {
      "id": "viscositySplit",
      "name": "Viscosity Split",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "R sticky vs B runny — how hard the dyes chromatograph apart"
    },
    {
      "id": "wind",
      "name": "Wind",
      "default": 0.45,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Shared wind / vane strength (mouse steers; bass gusts)"
    },
    {
      "id": "temperature",
      "name": "Temperature",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "Phase change — evaporate hot dye, condense cool solvent"
    },
    {
      "id": "dyeInject",
      "name": "Dye Inject",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Hold-paint and click-splash amount"
    }
  ],
  "updatedParams": [
    { "index": 0, "name": "Viscosity Split", "default": 0.55, "min": 0, "max": 1, "step": 0.01 },
    { "index": 1, "name": "Wind", "default": 0.45, "min": 0, "max": 1, "step": 0.01 },
    { "index": 2, "name": "Temperature", "default": 0.4, "min": 0, "max": 1, "step": 0.01 },
    { "index": 3, "name": "Dye Inject", "default": 0.6, "min": 0, "max": 1, "step": 0.01 }
  ],
  "feedbackPacking": "A/C = separated dye RGB and solvent temperature; all seven graph dispatches hand off through A only",
  "features": [
    "simulation",
    "multi-pass",
    "graph-runner",
    "physics",
    "mouse-driven",
    "audio-reactive",
    "interactive", "exact-load-feedback", "a-only-feedback", "held-drag", "click-reactive", "aces-tone-map", "semantic-alpha"
  ],
  "tags": [
    "fluid",
    "chromatography",
    "simulation",
    "physics",
    "showcase"
  ]
}

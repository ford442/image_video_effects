{
  "id": "murmuration",
  "name": "Murmuration",
  "url": "shaders/murmuration-flock.wgsl",
  "description": "Physics Lab — 65k birds steer on their neighbours (separation, alignment, cohesion) through a spatial hash and leave iridescent, fading trails over a dusk sky. The pointer is a predator; bass tightens cohesion. graph · 3 passes · @group(1) sim ring + hash.",
  "params": [
    {
      "id": "cohesion",
      "name": "Cohesion",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "How hard each bird pulls toward its neighbours' centre — bass tightens it",
      "audio": "bass"
    },
    {
      "id": "alignment",
      "name": "Alignment",
      "default": 0.65,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "How closely each bird matches its neighbours' heading",
      "audio": "mid"
    },
    {
      "id": "perception",
      "name": "Perception",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "Neighbour radius: small makes cliques, large makes sweeping sheets"
    },
    {
      "id": "trailLength",
      "name": "Trail Length",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "How long the iridescent wake lingers",
      "audio": "treble"
    }
  ],
  "features": [
    "audio-driven",
    "audio-reactive",
    "graph-runner",
    "interactive",
    "mouse-driven",
    "multi-pass",
    "particles",
    "physics",
    "sim-ring",
    "spatial-hash",
    "simulation",
    "temporal-persistence"
  ],
  "tags": [
    "audio",
    "birds",
    "flocking",
    "murmuration",
    "music",
    "physics",
    "reactive",
    "showcase",
    "simulation"
  ],
  "multipass": {
    "graph": {
      "maxPassesPerFrame": 8,
      "nodes": [
        {
          "id": "flock",
          "entry": "murmuration-flock",
          "dispatch": "simState",
          "reads": [
            "simIndex",
            "simHash"
          ],
          "writes": [
            "simState",
            "dataA"
          ]
        },
        {
          "id": "render",
          "entry": "murmuration-render",
          "reads": [
            "dataC"
          ],
          "writes": [
            "color",
            "dataA"
          ]
        }
      ]
    }
  },
  "simRing": {
    "stateCount": 65536,
    "spatialHash": true,
    "agent": "bird",
    "packing": "xy position (px, torus), zw velocity (px/frame)"
  }
}

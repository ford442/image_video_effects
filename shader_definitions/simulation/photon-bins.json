{
  "id": "photon-bins",
  "name": "Photon Bins",
  "url": "shaders/photon-bins-march.wgsl",
  "description": "Physics Lab — the agent form of Photonic Caustics: 65k photons with a wavelength and an energy bend and bounce across a height field taken from the image, are binned in a spatial hash, and splat into a spectral caustic accumulator. Move the light; bass kicks the bending. graph · 4 passes · @group(1) sim ring + hash.",
  "params": [
    {
      "id": "indexContrast",
      "name": "Index Contrast",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "How strongly the image bends and reflects the rays — bass kicks it",
      "audio": "bass"
    },
    {
      "id": "dispersion",
      "name": "Dispersion",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "How far blue bends from red — splits caustics into rainbow ribbons",
      "audio": "mid"
    },
    {
      "id": "lightSize",
      "name": "Light Size",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "Radius of the emitting disc around each light"
    },
    {
      "id": "persistence",
      "name": "Persistence",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "How long caustic energy lingers in the accumulator",
      "audio": "treble"
    }
  ],
  "features": [
    "audio-driven",
    "audio-reactive",
    "graph-runner",
    "interactive",
    "mouse-driven",
    "multi-pass",
    "particles",
    "physics",
    "sim-ring",
    "spatial-hash",
    "simulation",
    "temporal-persistence"
  ],
  "tags": [
    "audio",
    "caustics",
    "light",
    "music",
    "photons",
    "physics",
    "reactive",
    "refraction",
    "showcase",
    "simulation"
  ],
  "multipass": {
    "graph": {
      "maxPassesPerFrame": 8,
      "nodes": [
        {
          "id": "march",
          "entry": "photon-bins-march",
          "dispatch": "simState",
          "reads": [
            "read"
          ],
          "writes": [
            "simState"
          ]
        },
        {
          "id": "splat",
          "entry": "photon-bins-splat",
          "reads": [
            "dataC",
            "simIndex",
            "simHash"
          ],
          "writes": [
            "dataA"
          ]
        },
        {
          "id": "present",
          "entry": "photon-bins-present",
          "reads": [
            "dataC"
          ],
          "writes": [
            "color"
          ]
        }
      ]
    }
  },
  "simRing": {
    "stateCount": 65536,
    "spatialHash": true,
    "agent": "photon",
    "packing": "xy position (px), z heading, w wavelength bin + energy"
  }
}

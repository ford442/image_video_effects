{
  "id": "ripple-tank",
  "name": "Ripple Tank",
  "url": "shaders/ripple-tank-step.wgsl",
  "description": "Physics Lab flagship — click for rings, hold for a driven oscillator, audio rains droplets across the tank. 7 graph passes · target 60 fps at balanced.",
  "requiresRgba32Float": true,
  "multipass": {
    "graph": {
      "maxPassesPerFrame": 10,
      "nodes": [
        {
          "id": "step",
          "entry": "ripple-tank-step",
          "reads": ["dataC"],
          "writes": ["dataA"],
          "repeat": 4
        },
        {
          "id": "inject",
          "entry": "ripple-tank-inject",
          "reads": ["dataA"],
          "writes": ["dataB"]
        },
        {
          "id": "gather",
          "entry": "ripple-tank-pass2",
          "reads": ["dataB"],
          "writes": []
        },
        {
          "id": "render",
          "entry": "ripple-tank-pass3",
          "reads": ["dataB"],
          "writes": ["color", "dataA"]
        }
      ]
    }
  },
  "params": [
    {
      "id": "waveSpeed",
      "name": "Wave Speed",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "Propagation speed c of the discrete wave equation (0.08–0.45 world units)"
    },
    {
      "id": "damping",
      "name": "Damping",
      "default": 0.65,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Velocity retention per step (0.975–0.9995) — high values ring for seconds"
    },
    {
      "id": "sourceStrength",
      "name": "Source Strength",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "Amplitude and frequency of mouse driver, click ripples, and audio rain"
    },
    {
      "id": "boundaryReflect",
      "name": "Boundary Reflect",
      "default": 0.7,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Edge behavior: 0 = absorbing shore, 1 = fully reflecting tank walls"
    }
  ],
  "features": [
    "simulation",
    "multi-pass",
    "graph-runner",
    "physics",
    "mouse-driven",
    "audio-reactive",
    "depth-aware",
    "temporal-persistence",
    "interactive"
  ],
  "tags": [
    "wave-equation",
    "interference",
    "caustics",
    "water",
    "simulation",
    "showcase"
  ]
}

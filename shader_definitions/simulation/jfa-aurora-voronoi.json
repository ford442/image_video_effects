{
  "id": "jfa-aurora-voronoi",
  "name": "JFA Aurora Voronoi",
  "url": "shaders/jfa-aurora-seed.wgsl",
  "description": "Phase C stretch — Jump-Flood aurora Voronoi from mouse seeds. graph · seed + flood×8 + render.",
  "multipass": {
    "graph": {
      "maxPassesPerFrame": 10,
      "nodes": [
        { "id": "seed", "entry": "jfa-aurora-seed", "reads": ["dataC"], "writes": ["dataA"] },
        { "id": "flood", "entry": "jfa-aurora-flood", "reads": ["dataC"], "writes": ["dataA"], "repeat": 8 },
        { "id": "render", "entry": "jfa-aurora-render", "reads": ["dataC"], "writes": ["color", "dataA"] }
      ]
    }
  },
  "params": [
    {
      "id": "jumpScale",
      "name": "Jump Scale",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "audio": "mid",
      "description": "JFA jump radius scale per flood pass"
    },
    {
      "id": "auroraHue",
      "name": "Aurora Hue",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "audio": "treble",
      "description": "Aurora palette scroll and distance tint"
    },
    {
      "id": "glow",
      "name": "Glow",
      "default": 0.65,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "audio": "bass",
      "description": "Cell glow intensity and random seed density"
    },
    {
      "id": "seedStrength",
      "name": "Seed Strength",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "audio": "overall",
      "description": "Mouse and click seed radius"
    }
  ],
  "features": [
    "simulation",
    "multi-pass",
    "graph-runner",
    "physics",
    "mouse-driven",
    "audio-reactive",
    "interactive"
  ],
  "tags": [
    "jfa",
    "voronoi",
    "aurora",
    "simulation",
    "physics",
    "showcase"
  ]
}

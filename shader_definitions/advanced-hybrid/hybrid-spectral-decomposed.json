{
  "id": "hybrid-spectral-decomposed",
  "name": "Hybrid Spectral Decomposed",
  "url": "shaders/hybrid-spectral-decomposed.wgsl",
  "description": "Splits the image into four difference-of-Gaussian frequency bands, pixel-sorts each along its own angle in threshold-gated streak runs, tints them with spectral palettes and recombines them with bass/mids/treble as a live 4-band EQ.",
  "features": [
    "advanced-hybrid",
    "pixel-sorting",
    "spectral-decomposition",
    "audio-reactive",
    "mouse-driven",
    "randomization-safe",
    "audio-driven",
    "upgraded-rgba"
  ],
  "params": [
    {
      "id": "sort_threshold",
      "name": "Sort Sensitivity",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "Base luminance threshold for pixel sorting"
    },
    {
      "id": "spectral_bands",
      "name": "Spectral Bands",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Number of frequency bands for coloring"
    },
    {

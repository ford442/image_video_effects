{
  "id": "spec-temporal-path-tracer",
  "name": "Temporal Path Tracer",
  "url": "shaders/spec-temporal-path-tracer.wgsl",
  "description": "2D path tracer with temporal accumulation. Casts light rays that bounce off image edges, accumulating Monte Carlo samples over time for soft global illumination and color bleeding. Hit radiance falls off with distance so colour bleed stays local, the marcher's step lattice is jittered so the converged image has no quantisation rings, and the history re-converges when the source changes (or while the pointer light is held) instead of ghosting for 300 frames and then hard-resetting.",
  "tags": [
    "path-tracing",
    "temporal",
    "monte-carlo",
    "global-illumination",
    "ray-marching"
  ],
  "features": [
    "temporal-accumulation",
    "path-tracing",
    "Monte-Carlo",
    "mouse-driven",
    "HDR",
    "multi-pass-1",
    "upgraded-rgba"
  ],
  "params": [
    {
      "id": "bounces",
      "name": "Max Bounces",
      "default": 0.4,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "edge_threshold",
      "name": "Edge Threshold",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {

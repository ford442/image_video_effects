          "step": 0.01
        },
        {
          "index": 2,
          "name": "Orbital Trail",
          "default": 0.8,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 3,
          "name": "Star Density",
          "default": 0.5,

{
  "id": "gen-astro-orrery-blackbody",
  "name": "Astro Orrery Blackbody",
  "url": "shaders/gen-astro-orrery-blackbody.wgsl",
  "description": "A kinetic astronomical orrery where each ring's thermal energy determines its blackbody color. Rotating rings glow with physically accurate star temperatures from cool red dwarfs to blazing blue giants.",
  "tags": [
    "astronomical",
    "blackbody",
    "thermal",
    "orrery",
    "space",
    "physical",
    "HDR"
  ],
  "features": [
    "audio-reactive",
    "mouse-driven",
    "raymarched",
    "temporal",
    "upgraded-rgba"
  ],
  "params": [
    {
      "id": "ringSpread",
      "name": "Ring Spread",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "How far the inner and outer annuli open around the original ring"
    },
    {
      "id": "temperature",
      "name": "Temperature",
      "default": 0.08,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Blackbody temperature of the main ring. The default is the original orange"
    },
    {
      "id": "trail",
      "name": "Orbital Trail",
      "default": 0.8,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "How much of the previous frame is kept, sampled against the spiral's rotation"
    },
    {
      "id": "starDensity",
      "name": "Star Density",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "How many parallax stars pass the brightness threshold"
    }
  ],
  "x-meta": {
    "upgrade": {
      "params": [
        {
          "index": 0,
          "name": "Ring Spread",
          "default": 0.55,
          "min": 0,

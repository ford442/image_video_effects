{
  "id": "voronoi-zoom-turbulence",
  "name": "Voronoi Zoom Turbulence",
  "url": "shaders/voronoi-zoom-turbulence.wgsl",
  "description": "Voronoi cells pulse with closed-form zoom and site-boundary shear conveyors. Sprung pointer agitates or calms cells, clicks emit zoom fronts, exact-C persistence, ACES display, and semantic agitation alpha.",
  "params": [
    {
      "name": "Cell Density",
      "type": "float",
      "default": 1,
      "min": 1,
      "max": 5,
      "target": "zoom_params.x",
      "id": "cell_density"
    },
    {
      "name": "Turbulence Speed",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 3,
      "target": "zoom_params.y",
      "id": "turbulence_speed"
    },
    {
      "name": "Zoom Intensity",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 2,
      "target": "zoom_params.z",
      "id": "zoom_intensity"
    },
    {
      "name": "Mouse Influence",
      "type": "float",
      "default": 1,
      "min": -1,
      "max": 1,
      "target": "zoom_params.w",
      "id": "mouse_influence"
    }
  ],
  "features": [
    "mouse-driven",
    "upgraded-rgba",
    "audio-reactive",
    "depth-aware",
    "held-drag",
    "bounded-click-ripples",
    "aces-tone-map",
    "temporal-feedback",
    "fast-motion",
    "spring-cursor",
    "semantic-alpha",
    "exact-c-history"
  ],
  "tags": [
    "filter",

{
  "id": "datamosh",
  "name": "Datamosh",
  "url": "shaders/datamosh.wgsl",
  "description": "Corrected single-state datamoshing: authoritative A packs motion, age, and strength, while current source pixels are predicted through that state with sprung scrubbing, bounded click corruption, ACES, and semantic alpha.",
  "features": [
    "mouse-driven",
    "temporal-state",
    "upgraded-rgba",
    "audio-reactive",
    "depth-aware",
    "click-reactive",
    "aces-tone-map"
  ],
  "tags": [
    "datamosh",
    "glitch",
    "compression",
    "motion-vectors",
    "retro",
    "video-artifacts",
    "smear",
    "trail"
  ],
  "params": [
    {
      "id": "motion_strength",
      "name": "Motion Strength",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Strength of motion vector displacement (creates smearing trails)"
    },
    {
      "id": "iframe_interval",
      "name": "I-Frame Interval",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "Time between full frame refreshes (0=often, 1=rarely)"
    },
    {
      "id": "blend_amount",
      "name": "Smear Blend",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "How much displaced pixels blend with current frame"
    },
    {
      "id": "feedback_decay",
      "name": "Trail Decay",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "description": "How long motion trails persist (higher=longer trails)"
    }
  ],

{
  "id": "crystal-mosaic",
  "name": "Crystal Mosaic",
  "category": "geometric",
  "url": "shaders/crystal-mosaic.wgsl",
  "description": "Image broken into triangular mosaic tiles that rotate based on mouse proximity. Enhanced with crystal Fresnel refraction lighting, caustics projection, rim lighting on tile edges, subsurface scattering glow, light attenuation, and chromatic aberration at tile boundaries.",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "depth-aware",
    "upgraded-rgba",
    "chromatic-edges",
    "crystal-refraction",
    "caustics",
    "rim-lighting",
    "subsurface-scattering",
    "light-attenuation",
    "Fresnel-reflections"
  ],
  "params": [
    {
      "id": "density",
      "name": "Tile Density",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "rotation",
      "name": "Rotation Amount",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "id": "chroma",
      "name": "Chromatic Edge",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "id": "influence",
      "name": "Mouse Influence",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "tags": [
    "mosaic",
    "crystal",
    "geometric",
    "triangular",
    "mouse-driven",
    "audio-reactive",
    "depth-aware",
    "chromatic",
    "caustics",
    "refraction",
    "subsurface-scattering"
  ]
}

{
  "id": "gen-neon-geode-crystallization",
  "name": "Neon Geode Crystallization",
  "url": "shaders/gen-neon-geode-crystallization.wgsl",
  "description": "An endlessly shifting landscape of procedural bismuth-like crystals erupting with luminescent neon plasma.",
  "tags": ["crystal", "neon", "geometric", "organic", "plasma"],
  "features": ["audio-reactive", "mouse-control", "raymarching"],
  "params": [
    {
      "id": "plasma_intensity",
      "name": "Plasma Intensity",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "audio": "bass"
    },
    {
      "id": "crystal_fold",
      "name": "Crystal Fold",
      "default": 1.0,
      "min": 0.0,
      "max": 5.0,
      "step": 0.1,
      "mapping": "zoom_params.y",
      "audio": "mid"
    },
    {
      "id": "bloom_radius",
      "name": "Bloom Radius",
      "default": 0.8,
      "min": 0.1,
      "max": 2.0,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "audio": "treble"
    },
    {
      "id": "geometry_twist",
      "name": "Geometry Twist",
      "default": 0.0,
      "min": -3.14,
      "max": 3.14,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ],
  "workgroup_size": [16, 16, 1],
  "category": "generative"
}
{
  "id": "gen-cymatic-bloom-fronds",
  "name": "Cymatic Bloom Fronds",
  "category": "generative",
  "url": "shaders/gen-cymatic-bloom-fronds.wgsl",
  "tags": [
    "generative",
    "cymatic",
    "fern",
    "fractal",
    "audio-reactive",
    "mouse-driven",
    "depth-aware",
    "organic"
  ],
  "description": "Barnsley fern fronds bloom under bass-driven growth, shimmer with cymatic standing-wave rims on mids, and scatter treble jitter across the field. Mouse warps the coordinate space; depth softens background fronds.",
  "workgroup_size": [
    16,
    16,
    1
  ],
  "supportsDepth": true,
  "supportsDof": false,
  "updated": true,
  "features": [
    "audio-reactive",
    "mouse-driven",
    "depth-aware",
    "barnsley-ifs",
    "domain-warp",
    "aces-tone-map",
    "ign-dither"
  ],
  "params": [
    {
      "id": "growth_rate",
      "name": "Growth Rate",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "cymatic_frequency",
      "name": "Cymatic Frequency",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y"
    },
    {
      "id": "frond_scale",
      "name": "Frond Scale",
      "default": 0.45,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z"
    },
    {
      "id": "trail_decay",
      "name": "Trail Decay",
      "default": 0.35,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ]
}

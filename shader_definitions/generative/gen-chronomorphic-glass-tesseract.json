{
  "id": "gen-chronomorphic-glass-tesseract",
  "name": "Chronomorphic Glass Tesseract",
  "type": "generative",
  "category": "generative",
  "url": "shaders/gen-chronomorphic-glass-tesseract.wgsl",
  "description": "A hyper-dimensional glass-like structure that morphs through time, capturing light in internal reflections while audio-reactive elements shatter and rebuild its crystalline facets.",
  "tags": [
    "quantum",
    "glass",
    "tesseract",
    "audio-reactive",
    "hyper-dimensional",
    "refraction"
  ],
  "features": [
    "audio-reactive",
    "mouse-interactive",
    "raymarching"
  ],
  "workgroup_size": [
    16,
    16,
    1
  ],
  "params": [
    {
      "id": "shatter_intensity",
      "name": "Shatter Intensity",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "refraction_index",
      "name": "Refraction Index",
      "default": 1.33,
      "min": 1.0,
      "max": 2.0,
      "step": 0.01,
      "mapping": "zoom_params.y"
    },
    {
      "id": "color_shift",
      "name": "Color Shift",
      "default": 0.0,
      "min": -1.0,
      "max": 1.0,
      "step": 0.1,
      "mapping": "zoom_params.z"
    },
    {
      "id": "mouse_gravity",
      "name": "Mouse Gravity",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ]
}
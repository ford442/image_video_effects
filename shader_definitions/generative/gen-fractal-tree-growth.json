    {"id": "growthPhase", "name": "Growth Phase", "default": 0.75, "min": 0, "max": 1, "step": 0.01, "mapping": "zoom_params.z"},
    {"id": "leafGlow", "name": "Leaf Glow", "default": 0.65, "min": 0, "max": 1, "step": 0.01, "mapping": "zoom_params.w"}

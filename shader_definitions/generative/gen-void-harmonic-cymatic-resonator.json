{
  "id": "gen-void-harmonic-cymatic-resonator",
  "name": "Void Harmonic Cymatic Resonator",
  "category": "generative",
  "url": "/shaders/gen-void-harmonic-cymatic-resonator.wgsl",
  "description": "A hyper-dimensional sound-reactive sculpture that renders the visible form of acoustic frequencies in the void.",
  "author": "Jules",
  "params": [
    {
      "id": "freq",
      "name": "Frequency",
      "mapping": "zoom_params.x",
      "default": 1.0,
      "min": 0.1,
      "max": 10.0,
      "step": 0.1
    },
    {
      "id": "amp",
      "name": "Amplitude",
      "mapping": "zoom_params.y",
      "default": 1.0,
      "min": 0.0,
      "max": 5.0,
      "step": 0.1
    },
    {
      "id": "glow",
      "name": "Glow Intensity",
      "mapping": "zoom_params.z",
      "default": 2.0,
      "min": 0.1,
      "max": 10.0,
      "step": 0.1
    },
    {
      "id": "comp",
      "name": "Complexity",
      "mapping": "zoom_params.w",
      "default": 3.0,
      "min": 1.0,
      "max": 10.0,
      "step": 1.0
    }
  ]
}
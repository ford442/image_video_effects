{
  "id": "gen-resonant-crystal-canyons",
  "name": "Resonant Crystal-Canyons",
  "url": "shaders/gen-resonant-crystal-canyons.wgsl",
  "category": "generative",
  "description": "An infinite, procedural canyon constructed entirely from highly refractive, glowing crystals where sound waves manifest as visible ripples of chromatic dispersion, flowing like rivers of light through the jagged terrain.",
  "tags": [
    "crystal",
    "landscape",
    "audio-reactive",
    "dispersion",
    "fractal",
    "canyon",
    "raymarched",
    "domain-warped"
  ],
  "features": [
    "procedural",
    "audio-reactive",
    "mouse-driven",
    "upgraded-rgba",
    "depth-aware",
    "thin-film-interference",
    "chromatic"
  ],
  "params": [
    {
      "id": "crystalDensity",
      "name": "Crystal Density",
      "default": 0.27,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "plasmaGlow",
      "name": "Plasma Glow",
      "default": 0.44,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y"
    },
    {
      "id": "refractiveIndex",
      "name": "Refractive Index",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z"
    },
    {
      "id": "audioReactivity",
      "name": "Audio Reactivity",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ]

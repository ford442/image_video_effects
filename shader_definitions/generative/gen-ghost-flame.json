    { "id": "cooling-rate", "name": "Cooling Rate", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "mapping": "zoom_params.z" },
    { "id": "diffusion", "name": "Diffusion", "default": 0.5, "min": 0, "max": 1, "step": 0.01, "mapping": "zoom_params.w" }

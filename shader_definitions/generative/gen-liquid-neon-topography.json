    { "id": "emissiveGlow", "name": "Emissive Glow", "mapping": "zoom_params.z", "default": 1.5, "min": 0.5, "max": 4.0, "step": 0.1 },
    { "id": "contourDetail", "name": "Contour Detail", "mapping": "zoom_params.w", "default": 4.0, "min": 1.0, "max": 8.0, "step": 1.0 }
  ]
}

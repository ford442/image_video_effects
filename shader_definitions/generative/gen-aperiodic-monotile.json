    16,
    16,
    1
  ],
  "supportsDepth": true,
  "supportsDof": false,
  "updated": true,
  "id": "gen-aperiodic-monotile",
  "url": "shaders/gen-aperiodic-monotile.wgsl",
  "features": [
    "sdf-relief-sculpture",
    "raymarch",
    "audio-reactive",
    "temporal-feedback",
    "depth-output",
    "upgraded-rgba"
  ],

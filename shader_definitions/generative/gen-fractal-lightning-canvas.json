{
  "id": "gen-fractal-lightning-canvas",
  "name": "Fractal Lightning Canvas",
  "category": "generative",
  "url": "shaders/gen-fractal-lightning-canvas.wgsl",
  "tags": [
    "generative",
    "lightning",
    "lichtenberg",
    "fractal",
    "audio-reactive",
    "mouse-driven",
    "depth-aware",
    "electric"
  ],
  "description": "Fractal Lichtenberg bolts crawl across a dark canvas. Bass seeds new discharge points, mids thicken branch filaments, and treble jitters the plasma edges. Mouse attracts a local strike; depth softens distant arcs.",
  "workgroup_size": [
    16,
    16,
    1
  ],
  "supportsDepth": true,
  "supportsDof": false,
  "updated": true,
  "features": [
    "audio-reactive",
    "mouse-driven",
    "depth-aware",
    "lichtenberg-branches",
    "aces-tone-map",
    "ign-dither"
  ],
  "params": [
    {
      "id": "branch_density",
      "name": "Branch Density",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "glow_intensity",
      "name": "Glow Intensity",
      "default": 0.55,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y"
    },
    {
      "id": "strike_rate",
      "name": "Strike Rate",
      "default": 0.45,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z"
    },
    {
      "id": "afterglow",
      "name": "Afterglow",
      "default": 0.6,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ]
}

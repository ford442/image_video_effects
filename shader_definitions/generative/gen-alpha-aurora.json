    16,
    16,
    1
  ],
  "supportsDepth": true,
  "supportsDof": false,
  "updated": true,
  "id": "gen-alpha-aurora",
  "url": "shaders/gen-alpha-aurora.wgsl",
  "features": [
    "audio-reactive",
    "upgraded-rgba"
  ],

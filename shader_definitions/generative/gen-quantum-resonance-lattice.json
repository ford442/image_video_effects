{
  "id": "gen-quantum-resonance-lattice",
  "name": "Quantum Resonance Lattice",
  "url": "shaders/gen-quantum-resonance-lattice.wgsl",
  "type": "generative",
  "category": "generative",
  "description": "A highly ordered lattice of vibrating quantum nodes that spontaneously shatters and reconstitutes in rhythmic waves.",
  "tags": [
    "quantum",
    "lattice",
    "raymarching",
    "SDF",
    "chromatic-aberration"

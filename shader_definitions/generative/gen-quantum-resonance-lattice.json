  "params": [
    {
      "id": "node_spacing",
      "name": "Node Spacing",
      "default": 1.5,
      "min": 0.5,
      "max": 3.0,
      "step": 0.1,
      "mapping": "zoom_params.x"
    },
    {
      "id": "wave_amplitude",
      "name": "Wave Amplitude",
      "default": 1.0,
      "min": 0.0,
      "max": 3.0,
      "step": 0.1,
      "mapping": "zoom_params.y"
    },
    {
      "id": "travel_speed",
      "name": "Travel Speed",
      "default": 2.0,
      "min": 0.0,
      "max": 5.0,
      "step": 0.1,
      "mapping": "zoom_params.z"
    },
    {
      "id": "chaos_factor",
      "name": "Chaos Factor",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "mapping": "zoom_params.w"
    }
  ]
}
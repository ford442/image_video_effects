  "description": "Heighway dragon curve \u2014 a space-filling fractal created by repeatedly folding a strip of paper in half. Rendered as a glowing neon filament with iteration-depth coloring from red to violet, upgraded with thin-film iridescence, a warm-key / cool-fill two-temperature glow rig, split-tone grading, atmospheric depth haze, and ACES tone mapping. Audio drives fold depth and FFT-shimmered halo, mouse zooms into detail, and depth controls line thickness perspective.",
  "workgroup_size": [
    16,
    16,
    1
  ],
  "params": [
    { "id": "zoom_detail", "name": "Zoom Detail", "default": 0.2, "min": 0.0, "max": 1.0, "step": 0.01, "mapping": "zoom_params.x" },
    { "id": "neon_glow_width", "name": "Neon Glow Width", "default": 0.5, "min": 0.0, "max": 1.0, "step": 0.01, "mapping": "zoom_params.y" },
    { "id": "fold_chromatic_aberration", "name": "Fold Chromatic Aberration", "default": 0.3, "min": 0.0, "max": 1.0, "step": 0.01, "mapping": "zoom_params.z" },
    { "id": "temporal_feedback", "name": "Temporal Feedback", "default": 0.2, "min": 0.0, "max": 1.0, "step": 0.01, "mapping": "zoom_params.w" }
  ],

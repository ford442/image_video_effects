{
  "id": "gen-astral-plasma-accretion-forge",
  "name": "Astral Plasma Accretion Forge",
  "category": "generative",
  "url": "/shaders/gen-astral-plasma-accretion-forge.wgsl",
  "description": "A noisy, Keplerian-twisted accretion disk of blackbody plasma with pole flares around a small black horizon. Upgrade: cool midplane dust lanes absorb the plasma behind them (Core Density sets extinction, Core Temp sets the dust sublimation radius); Keplerian differential rotation (Omega ~ r^-1.5) shears plasma and dust into trailing spiral lanes; gravitational redshift cools and dims the inner rim toward the well. Drag to orbit; bass/mids raise the pole flares.",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba"
  ],
  "params": [
    {
      "id": "core_density",
      "name": "Core Density",
      "mapping": "zoom_params.x",
      "default": 0.5,
      "min": 0.1,
      "max": 1.0,
      "step": 0.01
    },
    {
      "id": "accretion_spin",
      "name": "Accretion Spin",
      "mapping": "zoom_params.y",
      "default": 0.3,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "id": "flux_intensity",
      "name": "Flux Intensity",
      "mapping": "zoom_params.z",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    },
    {
      "id": "core_temp",
      "name": "Core Temp",
      "mapping": "zoom_params.w",
      "default": 0.7,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01
    }
  ],

{
  "id": "gen-live-studio-tab",
  "name": "Live Studio Tab",
  "url": "shaders/gen-live-studio-tab.wgsl",
  "category": "generative",
  "description": "A broadcast studio control room aesthetic with live video preview, audio VU meters, waveform scopes, vector scopes, scanlines, chromatic separation, and a blinking LIVE indicator.",
  "tags": [
    "broadcast",
    "studio",
    "video-overlay",
    "audio-visualizer",
    "scanlines",
    "audio-reactive",
    "mouse-driven",
    "chromatic"
  ],
  "features": [
    "procedural",
    "audio-reactive",
    "mouse-driven",
    "upgraded-rgba",
    "depth-aware",
    "chromatic"
  ],
  "params": [
    {
      "id": "scanlineIntensity",
      "name": "Scanline Intensity",
      "default": 0.33,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "overlayOpacity",
      "name": "Overlay Opacity",
      "default": 0.67,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y"
    },
    {
      "id": "scopeScale",
      "name": "Scope Scale",
      "default": 0.75,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z"
    },
    {
      "id": "glitchAmount",
      "name": "Glitch Amount",
      "default": 0.15,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ]
}

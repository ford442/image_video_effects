    "audio-reactive",
    "procedural",
    "animated",
    "temporal",
    "chromatic",
    "depth-aware",
    "upgraded-rgba"
  ],
  "tags": [
    "procedural",
    "generative",
    "fractal",
    "julia",
    "orbit-trap",
    "abstract",
    "colorful"
  ],

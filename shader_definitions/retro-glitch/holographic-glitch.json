{
  "id": "holographic-glitch",
  "name": "Holographic Glitch",
  "category": "retro-glitch",
  "url": "shaders/holographic-glitch.wgsl",
  "description": "Sci-fi holographic projection with block glitch, chromatic aberration, depth-aware scanlines, temporal trails, ACES tone mapping and IGN dither.",

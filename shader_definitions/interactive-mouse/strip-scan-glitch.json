          "max": 1
        },
        {
          "index": 2,
          "name": "Glitch Jitter",
          "default": 0.3,
          "min": 0,
          "max": 1
        },
        {
          "index": 3,
          "name": "RGB Split",
          "default": 0.2,
          "min": 0,
          "max": 1
        }
      ]
    }
  }
}

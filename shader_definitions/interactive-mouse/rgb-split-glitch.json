{
  "id": "rgb-split-glitch",
  "name": "RGB Split Glitch",
  "url": "shaders/rgb-split-glitch.wgsl",
  "description": "4:2:0 composite split: full-res luma, half-res chroma, temporal chroma delay, herringbone alias, and block ringing, stronger near the pointer. Alternate lines grow hanging dots on luma steps, and the herringbone crawls upward with jitter.",
  "params": [
    {
      "id": "split",
      "name": "Split Dist",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "id": "angle",
      "name": "Angle Offset",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "id": "noise",
      "name": "Jitter Noise",
      "default": 0.2,
      "min": 0,
      "max": 1
    },
    {
      "id": "radius",
      "name": "Radius",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "glitch",
    "chromatic-aberration",
    "audio-reactive",
    "upgraded-rgba"
  ],
  "tags": [
    "filter",
    "image-processing"
  ]
}

{
  "id": "interactive-voronoi-lens",
  "name": "Interactive Voronoi Lens",
  "url": "shaders/interactive-voronoi-lens.wgsl",
  "category": "interactive-mouse",
  "description": "Voronoi cells act as audio-reactive lenslets with depth parallax, cursor refocus, glassy seam catch-lights, a spring-damped gravity well, click shockwaves and temporal trails.",
  "tags": [
    "voronoi",
    "lens",
    "distortion",
    "mouse-driven",
    "audio-reactive",
    "temporal-feedback",
    "depth-aware"
  ],
  "features": [
    "mouse-driven",
    "audio-reactive",
    "semantic-alpha",
    "upgraded-rgba",
    "temporal-persistence",
    "depth-aware"
  ],
  "workgroup_size": [
    16,
    16,
    1
  ],
  "params": [
    {
      "id": "cell_density",
      "name": "Cell Density",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "lens_strength",
      "name": "Lens Strength",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.y"
    },
    {
      "id": "chaos",
      "name": "Chaos",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.z"
    },
    {
      "id": "lens_curve",
      "name": "Lens Curve",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ]
}

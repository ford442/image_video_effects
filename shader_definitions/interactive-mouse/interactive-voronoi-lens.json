{
  "id": "interactive-voronoi-lens",
  "name": "Interactive Voronoi Lens",
  "url": "shaders/interactive-voronoi-lens.wgsl",
  "category": "interactive-mouse",
  "description": "Voronoi cells act as audio-reactive lenses with mouse-driven focus, temporal trail accumulation, depth-aware edge fog, and neon cell-boundary accents.",
  "tags": ["voronoi", "lens", "distortion", "mouse-driven", "audio-reactive", "temporal-feedback", "depth-aware"],
  "features": [
    "mouse-driven",
    "audio-reactive",
    "semantic-alpha",
    "upgraded-rgba",
    "temporal-persistence",
    "depth-aware"
  ],
  "workgroup_size": [16, 16, 1],
  "params": [
    {
      "id": "cell_density",
      "name": "Cell Density",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "param": "zoom_params.x"
    },
    {
      "id": "lens_strength",
      "name": "Lens Strength",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "param": "zoom_params.y"
    },
    {
      "id": "chaos",
      "name": "Chaos",
      "default": 0.2,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "param": "zoom_params.z"
    },
    {
      "id": "lens_curve",
      "name": "Lens Curve",
      "default": 0.5,
      "min": 0.0,
      "max": 1.0,
      "step": 0.01,
      "param": "zoom_params.w"
    }
  ]
}

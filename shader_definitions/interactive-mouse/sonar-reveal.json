{
  "id": "sonar-reveal",
  "name": "Sonar Reveal",
  "url": "shaders/sonar-reveal.wgsl",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "audio-driven",
    "upgraded-rgba"
  ],
  "description": "Reveals the original image in a sonar disc around the mouse over a dimmed, tinted world, with concentric ring fronts and click shockwaves. A PPI radar sweep arm rotates from the pointer trailing a phosphor afterglow wedge; image edges flash as contact blips when a ring or shock front passes over them; and the Echo Mix return drifts outward from the pointer over frames. Bass, mids and treble shove the rings, shift the rim colour and add sparkle.",
  "params": [
    {
      "name": "Reveal Size",
      "id": "size",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "name": "Ring Intensity",
      "id": "intensity",
      "default": 0.8,
      "min": 0,
      "max": 1
    },
    {
      "name": "Edge Softness",
      "id": "softness",
      "default": 0.2,
      "min": 0,
      "max": 1
    },
    {
      "name": "Color Mode",
      "id": "color",
      "default": 0,
      "min": 0,
      "max": 1
    }
  ],
  "tags": [
    "filter",
    "image-processing",
    "audio",
    "music",
    "reactive"
  ],
  "x-meta": {
    "upgrade": {
      "params": [
        {
          "index": 0,
          "name": "Reveal Size",
          "default": 0.3,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 1,
          "name": "Ring Intensity",
          "default": 0.8,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 2,
          "name": "Edge Softness",
          "default": 0.2,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 3,
          "name": "Echo Mix",
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      ]
    }
  }
}

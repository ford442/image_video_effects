{
  "id": "virtual-lens",
  "name": "Virtual Lens",
  "url": "shaders/virtual-lens.wgsl",
  "description": "A virtual magnifying glass focused on whatever is under the cursor: magnified content at other depths falls out of focus, and the glass reflects a mirrored, softened view of the surroundings toward its rim. Spectral tint, double-glass inner ring and Fresnel/depth-aware alpha.",
  "params": [
    {
      "id": "mag",
      "name": "Magnification",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "radius",
      "name": "Lens Radius",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "id": "aberration",
      "name": "Aberration",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "softness",
      "name": "Edge Softness",
      "default": 0.2,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "chromatic-aberration",
    "audio-reactive",
    "depth-aware",
    "upgraded-rgba"
  ],
  "tags": [
    "filter",
    "image-processing"
  ]
}

{
  "id": "poly-art",
  "name": "Poly Art",
  "url": "shaders/poly-art.wgsl",
  "description": "Low-poly Voronoi of the photo. Facets shrink where the picture is busy, the pointer tightens the grid, and the crease facing the light picks up a bevel.",
  "params": [
    {
      "id": "size",
      "name": "Cell Size",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "edges",
      "name": "Edge Width",
      "default": 0,
      "min": 0,
      "max": 1
    },
    {
      "id": "randomness",
      "name": "Randomness",
      "default": 1,
      "min": 0,
      "max": 1
    },
    {
      "id": "influence",
      "name": "Mouse Influence",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba"
  ],
  "tags": [
    "filter",
    "image-processing"
  ],
  "x-meta": {
    "upgrade": {
      "params": [
        {

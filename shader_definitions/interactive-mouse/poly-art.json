        },
        {
          "index": 1,
          "name": "Edge Width",
          "default": 0,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 2,
          "name": "Randomness",
          "default": 1,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 3,
          "name": "Mouse Influence",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      ]
    }
  }
}

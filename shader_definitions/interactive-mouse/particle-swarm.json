{
  "id": "particle-swarm",
  "name": "Particle Swarm",
  "url": "shaders/particle-swarm.wgsl",
  "description": "Boid swarm with anisotropic scattering: each particle reads its neighbours out of the state texture and applies cohesion, separation and alignment, so the field forms travelling flocks that move together. Per-particle FFT bands drive turbulence, the attractor is spring-damped through extraBuffer[133..136], and fast particles smear the plate along their travel.",
  "params": [
    {
      "id": "stiffness",
      "name": "Spring Stiffness",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "force",
      "name": "Mouse Force",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "damping",
      "name": "Damping",
      "default": 0.8,
      "min": 0,
      "max": 1
    },
    {
      "id": "radius",
      "name": "Interact Radius",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "temporal-persistence",
    "physics",
    "held-drag",
    "bounded-click-ripples",
    "audio-reactive",
    "per-band-fft",
    "depth-aware",
    "upgraded-rgba",
    "semantic-alpha",
    "aces",
    "spring-damper-pointer",
    "boid-cohesion",
    "henyey-greenstein",
    "motion-blur"
  ],
  "tags": [
    "filter",
    "image-processing",
    "particles",
    "swarm",
    "boids",
    "scattering",
    "physics"
  ],

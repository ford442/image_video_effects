      "min": 0,
      "max": 1
    },
    {
      "id": "softness",
      "name": "Edge Softness",
      "default": 0.2,
      "min": 0,
      "max": 1
    },
    {
      "id": "invert",
      "name": "Invert Mode",
      "default": 0,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "audio-reactive",
    "chromatic-pixelation",

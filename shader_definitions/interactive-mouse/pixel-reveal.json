{
  "id": "pixel-reveal",
  "name": "Pixel Reveal",
  "url": "shaders/pixel-reveal.wgsl",
  "category": "interactive-mouse",
  "description": "A mosaic that remembers the pointer, refines on a resolution ladder, and dithers colour by that same ladder. Hidden blocks sort bright pixels one cell along the scan, and a dark mortar marks the coarse tile edges. Revealed pixels decay back to hidden over time.",
  "params": [
    {
      "id": "pixelSize",
      "name": "Pixel Size",
      "default": 0.2,
      "min": 0,
      "max": 1
    },
    {
      "id": "radius",
      "name": "Radius",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "id": "softness",
      "name": "Edge Softness",
      "default": 0.2,
      "min": 0,
      "max": 1
    },
    {
      "id": "decay_rate",
      "name": "Temporal Decay",
      "default": 0.5,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "audio-reactive",
    "depth-aware",
    "upgraded-rgba"
  ],
  "tags": [
    "filter",
    "pixel-sort",
    "glitch",
    "scanlines",
    "film-grain",
    "chromatic",
    "temporal"
  ],
  "x-meta": {
    "upgrade": {
      "params": [
        {
          "index": 0,
          "name": "Pixel Size",
          "default": 0.2,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 1,
          "name": "Radius",
          "default": 0.3,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 2,
          "name": "Edge Softness",
          "default": 0.2,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 3,
          "name": "Temporal Decay",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      ]
    }
  }
}

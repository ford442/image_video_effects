{
  "id": "rgb-ripple-waves",
  "name": "RGB Ripple Waves",
  "url": "shaders/rgb-ripple-waves.wgsl",
  "description": "Separates RGB channels into distinct ripple waves emanating from the mouse cursor.",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba"
  ],
  "tags": [
    "filter",
    "image-processing"
  ],
  "params": [
    {
      "id": "wave_frequency",
      "name": "Wave Frequency",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "wave_speed",
      "name": "Wave Speed",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "wave_amplitude",
      "name": "Wave Amplitude",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "id": "channel_phase",
      "name": "Channel Phase",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    }
  ]
}

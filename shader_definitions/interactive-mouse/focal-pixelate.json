{
  "id": "focal-pixelate",
  "name": "Focal Pixelate",
  "url": "shaders/focal-pixelate.wgsl",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba"
  ],
  "description": "Mouse-driven focal pixelation with FBM domain warp, depth-aware fog, IGN dither, and semantic alpha for slot-chain compositing.",
  "workgroup_size": [16, 16, 1],
  "params": [
    {
      "id": "pixel_size",
      "name": "Pixel Size",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x",
      "description": "Size of pixelated blocks at the focus edge"
    },
    {
      "id": "focus_radius",
      "name": "Focus Radius",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y",
      "description": "Radius of the in-focus region"
    },
    {
      "id": "focus_softness",
      "name": "Focus Softness",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z",
      "description": "Falloff between focus and pixelation"
    },
    {
      "id": "invert_focus",
      "name": "Invert Focus",
      "default": 0,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Invert the focus region"
    }
  ],
  "tags": [
    "mouse-driven",
    "interactive"
  ]
}

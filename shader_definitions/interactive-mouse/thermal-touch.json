{
  "id": "thermal-touch",
  "name": "Thermal Touch",
  "url": "shaders/thermal-touch.wgsl",
  "category": "interactive-mouse",
  "description": "The pointer and clicks deposit inverse-square heat into a field that conducts with a 9-point laplacian and cools. The plate is a blackbody image with glow and isotherms. Image brightness is the temperature floor.",

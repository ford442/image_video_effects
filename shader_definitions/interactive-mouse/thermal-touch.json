    {
      "id": "heat-intensity",
      "name": "Heat Intensity",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "radius",
      "name": "Radius",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "ambient-temp",
      "name": "Ambient Temp",
      "default": 0.2,
      "min": 0,
      "max": 1
    },
    {
      "id": "cooling-rate",
      "name": "Cooling Rate",
      "default": 0.3,
      "min": 0,
      "max": 1
    }
  ],
  "features": [
    "mouse-driven",
    "audio-reactive",
    "temporal",
    "upgraded-rgba"
  ],
  "tags": [
    "thermal",
    "heat",
    "blackbody",
    "filter",
    "image-processing"
  ],

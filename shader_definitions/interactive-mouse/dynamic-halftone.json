        },
        {
          "index": 2,
          "name": "Contrast",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01
        },
        {
          "index": 3,
          "name": "Edge Sharpness",
          "default": 0.5,
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      ]
    }
  }

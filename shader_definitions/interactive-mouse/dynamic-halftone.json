{
  "id": "dynamic-halftone",
  "name": "Dynamic Halftone",
  "url": "shaders/dynamic-halftone.wgsl",
  "description": "Halftone dots that swell, pool and rag under the pointer, stretch toward it, and grow where the photo changes.",
  "params": [
    {
      "id": "density",
      "name": "Dot Density",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "radius",
      "name": "Mouse Radius",
      "default": 0.3,
      "min": 0,
      "max": 1
    },
    {
      "id": "contrast",
      "name": "Contrast",
      "default": 0.5,
      "min": 0,
      "max": 1
    },
    {
      "id": "edge_sharpness",
      "name": "Edge Sharpness",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w",
      "description": "Halftone dot edge sharpness (wired to zoom_params.w)"
    }
  ],
  "feedbackPacking": "A/C = premultiplied ACES display RGBA (C is not read back); B is unused",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba",
    "aces-tone-map",
    "three-band-audio",
    "halftone"
  ],
  "tags": [
    "halftone",
    "filter",
    "image-processing",
    "interactive",
    "audio-reactive"
  ],

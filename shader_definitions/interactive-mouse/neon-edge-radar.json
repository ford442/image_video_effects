{
  "id": "neon-edge-radar",
  "name": "Neon Edge Radar",
  "category": "interactive-mouse",
  "url": "shaders/neon-edge-radar.wgsl",
  "description": "PPI beam that lights edges, with a wake, range rings, and a held interrogate. Returns fall off with range, and the wake carries receiver speckle.",
  "workgroup_size": [16, 16, 1],
  "params": [
    {
      "id": "threshold",
      "name": "Edge Sensitivity",
      "default": 0.2,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "speed",
      "name": "Beam Speed",
      "default": 0.5,
      "min": 0.1,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y"
    },
    {
      "id": "width",
      "name": "Beam Width",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z"
    },
    {
      "id": "intensity",
      "name": "Neon Intensity",
      "default": 0.67,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ],
  "features": [
    "upgraded-rgba",
    "semantic-alpha",
    "mouse-driven",
    "audio-reactive",
    "audio-driven",
    "depth-aware",
    "aces-tone-map",
    "ign-dither",
    "fresnel-rim",
    "volumetric-fog",
    "hue-preserve-clamp",
    "blackbody-temperature"
  ],
  "tags": [
    "mouse-driven",
    "interactive",
    "audio",
    "music",
    "reactive"
  ]
}

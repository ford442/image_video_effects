{
  "id": "cyber-lens",
  "name": "Cyber Lens",
  "category": "distortion",
  "url": "shaders/cyber-lens.wgsl",
  "description": "Targeting HUD with rolling-shutter scan skew and per-band telemetry rings. The reticle tracks the cursor's velocity: a lead vector points where it is heading and the lock ring closes from open to tight as the cursor settles, with range ticks that spin while it seeks. Inside the lens disc a gradient contour trace outlines what the sensor sees. Click lock pings and phosphor persistence; cursor track state rides two corner texels of A.",
  "features": [
    "mouse-driven",
    "audio-reactive",
    "upgraded-rgba",
    "chromatic-aberration",
    "hud-overlay",
    "glitch",
    "held-drag",
    "bounded-click-ripples",
    "per-band-fft",
    "depth-aware",
    "semantic-alpha",
    "aces",
    "rolling-shutter",
    "telemetry-rings",
    "phosphor-persistence",
    "lock-on-reticle",
    "contour-trace"
  ],
  "tags": [
    "cyber",
    "lens",
    "grid",
    "chromatic",
    "audio-reactive",
    "hud",
    "glitch",
    "holographic",
    "targeting",
    "scifi"
  ],

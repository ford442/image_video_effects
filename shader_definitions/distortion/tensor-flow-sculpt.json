{
  "id": "tensor-flow-sculpt",
  "name": "Tensor Flow Sculpt",
  "url": "shaders/tensor-flow-sculpt.wgsl",
  "description": "Pushes the image like clay along the depth map's structure-tensor directions, warping only low frequencies so fine detail stays put.",
  "tags": [
    "depth-aware",
    "tensor-warp",
    "audio-reactive"
  ],
  "features": [
    "depth-aware",
    "tensor-warp",
    "audio-reactive",
    "upgraded-rgba"
  ],
  "params": [
    {
      "id": "sculpt_depth",
      "name": "Sculpt Depth",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.x"
    },
    {
      "id": "freq_separation",
      "name": "Freq Separation",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.y"
    },
    {
      "id": "curvature_scale",
      "name": "Curvature Scale",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.z"
    },
    {
      "id": "anim_speed",
      "name": "Anim Speed",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "mapping": "zoom_params.w"
    }
  ],
  "_seeded_by": "scripts/seed_orphan_shader_defs.py"
}
